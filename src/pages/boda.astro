---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout>
  <!-- is:inline ejecuta síncrono antes de pintar el DOM — evita flash de contenido protegido -->
  <script is:inline define:vars={{ BASE_URL: import.meta.env.BASE_URL }}>
    if (sessionStorage.getItem('boda_auth') !== 'ok') {
      window.location.replace(BASE_URL);
    }
  </script>

  <main>
    <Hero />
  </main>
</Layout>
