---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alba & Antonio · 24·07·2027',
  description = 'Invitación de boda · Priego de Córdoba · 24 de julio de 2027',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#F3E9D2" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Great+Vibes&family=Lato:wght@300;400;700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <noscript>
      <div style="position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:#F3E9D2;color:#1E3A5F;font-family:'Cormorant Garamond',Georgia,serif;font-size:1.2rem;text-align:center;padding:2rem;z-index:9999;">
        Esta invitación necesita JavaScript activado. Por favor, actívalo para verla.
      </div>
    </noscript>
    <slot />

    <!-- Overlay tipo hoja que se pasa — animación de transición -->
    <div id="pagina-overlay" class="pagina-overlay" aria-hidden="true">
      <div class="pagina-overlay-sombra"></div>
    </div>
  </body>
</html>
