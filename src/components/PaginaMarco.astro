---
/**
 * Marco de página: contenedor con textura, márgenes, esquinas y separadores opcionales.
 * Todas las decoraciones son props opcionales.
 */
interface Props {
  titulo?: string;
  esquinaSupIzq?: string;
  esquinaSupDer?: string;
  esquinaInfIzq?: string;
  esquinaInfDer?: string;
  fondoAcuarela?: string;
  separadorInicial?: string;
  clase?: string;
  scroll?: boolean;
}

const {
  titulo,
  esquinaSupIzq,
  esquinaSupDer,
  esquinaInfIzq,
  esquinaInfDer,
  fondoAcuarela,
  separadorInicial,
  clase = '',
  scroll = false,
} = Astro.props;
---

<article class={`pagina-marco ${clase} ${scroll ? 'pagina-scroll' : ''}`.trim()} aria-label={titulo}>
  {fondoAcuarela && (
    <img class="deco fondo-acuarela" src={fondoAcuarela} alt="" aria-hidden="true" onerror="this.style.display='none'" />
  )}
  {esquinaSupIzq && (
    <img class="deco esquina esquina-sup-izq" src={esquinaSupIzq} alt="" aria-hidden="true" onerror="this.style.display='none'" />
  )}
  {esquinaSupDer && (
    <img class="deco esquina esquina-sup-der" src={esquinaSupDer} alt="" aria-hidden="true" onerror="this.style.display='none'" />
  )}
  {esquinaInfIzq && (
    <img class="deco esquina esquina-inf-izq" src={esquinaInfIzq} alt="" aria-hidden="true" onerror="this.style.display='none'" />
  )}
  {esquinaInfDer && (
    <img class="deco esquina esquina-inf-der" src={esquinaInfDer} alt="" aria-hidden="true" onerror="this.style.display='none'" />
  )}

  <slot name="decoracion" />

  <div class="pagina-contenido">
    {separadorInicial && (
      <img class="deco separador" src={separadorInicial} alt="" aria-hidden="true" onerror="this.style.display='none'" />
    )}
    <slot />
  </div>

  <!-- Sombra del pliegue en desktop -->
  <div class="pliegue" aria-hidden="true"></div>
</article>

<style>
  .pagina-marco {
    position: relative;
    width: 100%;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(2.5rem, 6vh, 4rem) clamp(1.5rem, 6vw, 4rem) clamp(5rem, 10vh, 7rem);
    z-index: 2;
  }

  .pagina-marco.pagina-scroll {
    justify-content: flex-start;
    padding-top: clamp(3rem, 8vh, 5rem);
    padding-bottom: clamp(5rem, 12vh, 7rem);
  }

  .pagina-contenido {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* Sombra del pliegue izquierdo (libro abierto) — solo desktop */
  .pliegue {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 8%;
    height: 100%;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(60,40,20,0.13) 0%, transparent 100%);
    z-index: 2;
  }
  @media (min-width: 900px) {
    .pliegue { display: block; }
  }

  /* Decoraciones */
  .deco {
    position: absolute;
    pointer-events: none;
    user-select: none;
  }

  .fondo-acuarela {
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.22;
    z-index: 1;
  }

  .esquina {
    width: clamp(80px, 18vw, 180px);
    height: auto;
    z-index: 2;
    opacity: 0.85;
  }
  @media (min-width: 1024px) { .esquina { width: clamp(120px, 15vw, 220px); } }

  .esquina-sup-izq { top: 1.5rem; left: 1.5rem; }
  .esquina-sup-der { top: 1.5rem; right: 1.5rem; transform: scaleX(-1); }
  .esquina-inf-izq { bottom: 1.5rem; left: 1.5rem; transform: scaleY(-1); }
  .esquina-inf-der { bottom: 1.5rem; right: 1.5rem; transform: scale(-1, -1); }

  .separador {
    width: clamp(120px, 30vw, 200px);
    height: auto;
    opacity: 0.55;
    margin-bottom: 0.5rem;
  }
</style>
