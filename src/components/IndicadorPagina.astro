---
/**
 * Indicador de página abajo — números romanos, muy discreto.
 * Solo visible cuando autenticado === true.
 */
---

<div id="indicador-pagina" aria-live="polite" aria-label="Indicador de página">
  <span class="romanos"></span>
</div>

<style>
  #indicador-pagina {
    position: fixed;
    bottom: clamp(1rem, 2vh, 1.5rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 40;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    color: var(--color-tinta-clara);
    text-transform: uppercase;
    opacity: 0;
    pointer-events: none;
    transition: opacity 400ms ease;
  }
  #indicador-pagina.visible { opacity: 0.65; }
  #indicador-pagina .actual { color: var(--color-limon); }
</style>
