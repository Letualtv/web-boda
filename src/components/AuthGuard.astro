---
/**
 * Guard inline en <head>: si no está autenticado, redirige a /.
 * (La portada / es ahora también la pantalla de contraseña.)
 */
const base = import.meta.env.BASE_URL;
const url = (base + '').replace(/\/+/g, '/');
---

<script is:inline define:vars={{ ROOT_URL: url }}>
  (function () {
    try {
      if (sessionStorage.getItem('boda_auth') !== 'ok') {
        window.location.replace(ROOT_URL);
      }
    } catch (e) { /* ignorar */ }
  })();
</script>
