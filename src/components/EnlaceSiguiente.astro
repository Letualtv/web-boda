---
/**
 * Enlace discreto al final del contenido de una sección.
 * Integrado en el flujo, no flotante.
 */
interface Props {
  href: string;
  label?: string;
}
const { href, label = 'Siguiente' } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = (base + href.replace(/^\/+/, '')).replace(/\/+/g, '/');
---

<a class="enlace-siguiente" href={url}>
  <span>{label}</span>
  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M9 18l6-6-6-6"/>
  </svg>
</a>

<style>
  .enlace-siguiente {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
    padding: 0.6rem 1.5rem;
    color: var(--color-tinta-clara);
    font-family: var(--font-sans);
    font-size: clamp(0.65rem, 1.6vw, 0.75rem);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid rgba(30, 58, 95, 0.15);
    transition: color 250ms ease, border-color 250ms ease, gap 250ms ease;
  }
  .enlace-siguiente:hover {
    color: var(--color-tinta);
    border-color: rgba(30, 58, 95, 0.4);
    gap: 0.75rem;
  }
</style>
