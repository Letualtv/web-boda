---
/**
 * Navegación entre secciones — flechas anterior/siguiente + botón índice.
 * Usa Astro <a> con transiciones nativas para pases suaves.
 */
const SECCIONES = [
  { url: '/bienvenida/',  titulo: 'Bienvenida' },
  { url: '/historia/',    titulo: 'Nuestra historia' },
  { url: '/celebracion/', titulo: 'La celebración' },
  { url: '/autobuses/',   titulo: 'Cómo llegar' },
  { url: '/galeria/',     titulo: 'Recuerdos' },
];

interface Props {
  actual: string; // ruta actual, e.g. '/bienvenida/'
}
const { actual } = Astro.props;

const base = import.meta.env.BASE_URL;
const norm = (u: string) => (base + u.replace(/^\/+/, '')).replace(/\/+/g, '/');

const idx = SECCIONES.findIndex((s) => s.url === actual);
const anterior = idx > 0 ? SECCIONES[idx - 1] : null;
const siguiente = idx >= 0 && idx < SECCIONES.length - 1 ? SECCIONES[idx + 1] : null;
---

<nav class="nav-paginas" aria-label="Navegación de secciones">
  {anterior && (
    <a class="nav-btn nav-btn-prev" href={norm(anterior.url)} aria-label={`Anterior: ${anterior.titulo}`}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 18l-6-6 6-6"/>
      </svg>
      <span class="nav-txt">{anterior.titulo}</span>
    </a>
  )}
  <button type="button" class="nav-btn nav-btn-idx" id="btn-idx" aria-label="Índice">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="4" y1="7" x2="20" y2="7"/>
      <line x1="4" y1="12" x2="20" y2="12"/>
      <line x1="4" y1="17" x2="20" y2="17"/>
    </svg>
  </button>
  {siguiente && (
    <a class="nav-btn nav-btn-next" href={norm(siguiente.url)} aria-label={`Siguiente: ${siguiente.titulo}`}>
      <span class="nav-txt">{siguiente.titulo}</span>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18l6-6-6-6"/>
      </svg>
    </a>
  )}
</nav>

<!-- Overlay del índice -->
<div id="idx-overlay" class="idx-overlay" role="dialog" aria-modal="true" aria-label="Índice">
  <button id="idx-cerrar" class="idx-cerrar" aria-label="Cerrar índice">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="6" y1="6" x2="18" y2="18"/>
      <line x1="6" y1="18" x2="18" y2="6"/>
    </svg>
  </button>
  <div class="idx-inner">
    <h2 class="idx-titulo">Índice</h2>
    <ul class="idx-lista">
      {SECCIONES.map((s, i) => (
        <li>
          <a class={`idx-entrada ${s.url === actual ? 'activa' : ''}`} href={norm(s.url)}>
            <span class="idx-num">{['II','III','IV','V','VI'][i]}.</span>
            <span class="idx-titulo-entrada">{s.titulo}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .nav-paginas {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: clamp(0.75rem, 2vh, 1.25rem) clamp(0.75rem, 3vw, 1.5rem);
    gap: 0.5rem;
    z-index: 40;
    pointer-events: none;
  }

  .nav-btn {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    background: rgba(243, 233, 210, 0.85);
    border: 1px solid rgba(30, 58, 95, 0.2);
    color: var(--color-tinta);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    backdrop-filter: blur(6px);
    transition: background 250ms ease, transform 250ms ease;
    cursor: pointer;
  }
  .nav-btn:hover { background: rgba(243, 233, 210, 1); }
  .nav-btn:active { transform: scale(0.96); }

  .nav-btn-idx {
    padding: 0.55rem 0.7rem;
  }

  .nav-txt {
    max-width: 110px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* En móvil pequeño, ocultar el texto — solo flechas + índice */
  @media (max-width: 480px) {
    .nav-txt { display: none; }
    .nav-btn { padding: 0.55rem 0.7rem; }
  }

  /* ─── Overlay índice ─────────────────────────────────── */
  .idx-overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(243, 233, 210, 0.94);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 350ms ease;
  }
  .idx-overlay.abierto { opacity: 1; pointer-events: auto; }

  .idx-cerrar {
    position: absolute;
    top: clamp(1rem, 3vh, 1.75rem);
    right: clamp(1rem, 3vw, 1.75rem);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid rgba(30, 58, 95, 0.2);
    color: var(--color-tinta);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 250ms ease;
  }
  .idx-cerrar:hover { background: rgba(30, 58, 95, 0.08); }

  .idx-inner {
    text-align: center;
    padding: 2rem;
    max-width: 500px;
  }

  .idx-titulo {
    font-family: var(--font-brush);
    font-weight: 400;
    font-size: clamp(2.5rem, 8vw, 4rem);
    color: var(--color-tinta);
    margin: 0 0 2rem;
    line-height: 1;
  }

  .idx-lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 2vh, 1rem);
  }

  .idx-entrada {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 3.5vw, 1.5rem);
    color: var(--color-tinta);
    transition: color 250ms ease, transform 250ms ease;
  }
  .idx-entrada:hover { color: var(--color-teja); transform: translateX(4px); }
  .idx-entrada.activa { color: var(--color-teja); font-style: italic; }

  .idx-num {
    font-family: var(--font-sans);
    font-size: 0.7em;
    color: var(--color-limon);
    letter-spacing: 0.1em;
  }
  .idx-titulo-entrada {
    font-family: var(--font-brush);
    font-size: 1.3em;
  }
</style>

<script>
  const overlay = document.getElementById('idx-overlay');
  const btnAbrir = document.getElementById('btn-idx');
  const btnCerrar = document.getElementById('idx-cerrar');

  function abrir() {
    overlay?.classList.add('abierto');
    btnCerrar?.focus();
  }
  function cerrar() {
    overlay?.classList.remove('abierto');
  }

  btnAbrir?.addEventListener('click', abrir);
  btnCerrar?.addEventListener('click', cerrar);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) cerrar();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay?.classList.contains('abierto')) cerrar();
  });
</script>
