---
const WEDDING_DATE = '2027-07-24T12:00:00';

// theme="dark" → texto azul (sobre fondo claro)
// theme="light" → texto blanco (sobre fondo oscuro/foto)
const { theme = 'dark' } = Astro.props;

const numColor  = theme === 'light' ? 'rgba(250,246,238,0.95)' : '#2B5F8E';
const lblColor  = theme === 'light' ? 'rgba(250,246,238,0.45)' : 'rgba(43,95,142,0.5)';
const headColor = theme === 'light' ? 'rgba(250,246,238,0.4)'  : 'rgba(43,95,142,0.6)';
---

<div style="display:flex;flex-direction:column;align-items:center;gap:1.5rem;padding:1rem 0;">
  <p style={`font-family:'Lato',system-ui,sans-serif;font-size:0.6rem;letter-spacing:0.5em;text-transform:uppercase;color:${headColor};margin:0;`}>
    Quedan
  </p>

  <div id="countdown" style="display:flex;gap:clamp(1rem,5vw,3rem);text-align:center;align-items:flex-start;">
    {[
      { id: 'dias',     label: 'días'    },
      { id: 'horas',    label: 'horas'   },
      { id: 'minutos',  label: 'min'     },
      { id: 'segundos', label: 'seg'     },
    ].map(({ id, label }) => (
      <div style="display:flex;flex-direction:column;align-items:center;gap:0.35rem;">
        <span
          id={id}
          class="gsap-fade-up"
          style={`font-family:'Cormorant Garamond',Georgia,serif;font-weight:300;font-size:clamp(2.5rem,8vw,4rem);line-height:1;color:${numColor};font-variant-numeric:tabular-nums;`}
        >00</span>
        <span style={`font-family:'Lato',system-ui,sans-serif;font-size:0.5rem;letter-spacing:0.4em;text-transform:uppercase;color:${lblColor};`}>
          {label}
        </span>
      </div>
    ))}
  </div>
</div>

<script define:vars={{ WEDDING_DATE }}>
  const target = new Date(WEDDING_DATE).getTime();

  function pad(n) { return String(Math.floor(n)).padStart(2, '0'); }

  function tick() {
    const diff = target - Date.now();
    if (diff <= 0) {
      ['dias','horas','minutos','segundos'].forEach(id => {
        document.getElementById(id).textContent = '00';
      });
      clearInterval(intervalId);
      return;
    }
    document.getElementById('dias').textContent     = pad(diff / (1000*60*60*24));
    document.getElementById('horas').textContent    = pad((diff % (1000*60*60*24)) / (1000*60*60));
    document.getElementById('minutos').textContent  = pad((diff % (1000*60*60)) / (1000*60));
    document.getElementById('segundos').textContent = pad((diff % (1000*60)) / 1000);
  }

  tick();
  const intervalId = setInterval(tick, 1000);
  document.addEventListener('astro:before-swap', () => clearInterval(intervalId), { once: true });
</script>
