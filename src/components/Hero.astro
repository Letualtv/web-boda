---
import Countdown from './Countdown.astro';

// Pon vuestra foto en public/img/portada.jpg
// Si no existe, se usa el degradado de fondo como fallback
---

<style>
  /* Cuenta atrás en blanco sobre foto oscura */
  :global(#countdown span[id]) {
    color: rgba(250,246,238,0.95) !important;
  }
  :global(#countdown span:not([id])) {
    color: rgba(250,246,238,0.35) !important;
  }
  :global(#countdown p) {
    color: rgba(250,246,238,0.35) !important;
  }

  /* Botón de calendario */
  #cal-btn {
    background: transparent;
    border: 1px solid rgba(250,246,238,0.3);
    color: rgba(250,246,238,0.75);
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    padding: 0.85rem 1.75rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    transition: border-color 0.3s, color 0.3s, background 0.3s;
  }
  #cal-btn:hover {
    border-color: rgba(212,200,74,0.6);
    color: #D4C84A;
    background: rgba(212,200,74,0.05);
  }

  /* Dropdown opciones calendario */
  #cal-dropdown {
    position: absolute;
    bottom: calc(100% + 0.75rem);
    left: 50%;
    transform: translateX(-50%);
    background: #0a1520;
    border: 1px solid rgba(212,200,74,0.2);
    min-width: 200px;
    z-index: 20;
    display: none;
    flex-direction: column;
  }
  #cal-dropdown.open { display: flex; }
  #cal-dropdown a {
    display: block;
    padding: 0.85rem 1.25rem;
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(250,246,238,0.6);
    text-decoration: none;
    border-bottom: 1px solid rgba(212,200,74,0.08);
    transition: color 0.2s, background 0.2s;
  }
  #cal-dropdown a:last-child { border-bottom: none; }
  #cal-dropdown a:hover { color: #D4C84A; background: rgba(212,200,74,0.06); }
</style>

<section
  id="inicio"
  style="position:relative;min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;overflow:hidden;padding:2rem 1.5rem;"
>
  <!-- Foto de fondo con blur -->
  <!-- Pon vuestra foto en public/img/portada.jpg -->
  <div
    aria-hidden="true"
    style="position:absolute;inset:-5%;background-image:url('/img/portada.jpg'),linear-gradient(135deg,#0a1520 0%,#1a2d3e 50%,#0e2233 100%);background-size:cover;background-position:center;filter:blur(12px) brightness(0.55);z-index:0;"
  ></div>

  <!-- Overlay oscuro para legibilidad -->
  <div
    aria-hidden="true"
    style="position:absolute;inset:0;background:linear-gradient(to bottom,rgba(8,16,24,0.25) 0%,rgba(8,16,24,0.5) 100%);z-index:1;"
  ></div>

  <!-- Contenido -->
  <div style="position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;gap:1.75rem;max-width:480px;width:100%;">

    <!-- Etiqueta superior -->
    <p
      id="hero-pre"
      class="gsap-fade-up"
      style="font-family:'Lato',system-ui,sans-serif;font-weight:300;font-size:0.6rem;color:rgba(250,246,238,0.45);letter-spacing:0.55em;text-transform:uppercase;margin:0;"
    >
      Guarda la fecha
    </p>

    <!-- Nombres -->
    <h1
      id="hero-names"
      class="gsap-fade-up"
      style="font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-weight:300;color:#FAF6EE;line-height:1.05;margin:0;"
    >
      <span style="display:block;font-size:clamp(3.5rem,16vw,7rem);letter-spacing:0.02em;">Alba</span>
      <span style="display:block;font-size:clamp(1.25rem,5vw,2rem);color:#D4C84A;letter-spacing:0.3em;margin:0.25rem 0;">&amp;</span>
      <span style="display:block;font-size:clamp(3.5rem,16vw,7rem);letter-spacing:0.02em;">Antonio</span>
    </h1>

    <!-- Fecha -->
    <p
      id="hero-date"
      class="gsap-fade-up"
      style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:300;font-size:clamp(1rem,4vw,1.5rem);color:rgba(250,246,238,0.65);letter-spacing:0.35em;margin:0;"
    >
      24 · 07 · 2027
    </p>

    <!-- Separador -->
    <div style="display:flex;align-items:center;gap:0.85rem;width:60%;max-width:200px;">
      <div style="flex:1;height:1px;background:rgba(212,200,74,0.25);"></div>
      <svg width="6" height="6" viewBox="0 0 6 6" fill="#D4C84A" opacity="0.5">
        <path d="M3 0 L3.7 2.3 L6 3 L3.7 3.7 L3 6 L2.3 3.7 L0 3 L2.3 2.3 Z"/>
      </svg>
      <div style="flex:1;height:1px;background:rgba(212,200,74,0.25);"></div>
    </div>

    <!-- Cuenta atrás -->
    <div id="hero-countdown" class="gsap-fade-up" style="width:100%;">
      <Countdown />
    </div>

    <!-- Botón añadir al calendario -->
    <div id="cal-wrap" class="gsap-fade-up" style="position:relative;display:inline-block;">
      <div id="cal-dropdown">
        <a
          href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Boda%20Alba%20%26%20Antonio&dates=20270724T120000%2F20270724T235900&details=%C2%A1Nos%20casamos!%20Guarda%20este%20d%C3%ADa%20especial."
          target="_blank"
          rel="noopener noreferrer"
        >
          Google Calendar
        </a>
        <a href="#" id="ics-download">Descargar .ics</a>
      </div>
      <button id="cal-btn" type="button" aria-expanded="false">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2">
          <rect x="1" y="2" width="10" height="9" rx="1"/>
          <line x1="1" y1="5" x2="11" y2="5"/>
          <line x1="4" y1="0.5" x2="4" y2="3.5"/>
          <line x1="8" y1="0.5" x2="8" y2="3.5"/>
        </svg>
        Añadir al calendario
      </button>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animación de entrada en secuencia
  gsap.timeline({ defaults: { ease: 'power3.out', duration: 1 } })
    .to('#hero-pre',       { opacity: 1, y: 0, delay: 0.2 })
    .to('#hero-names',     { opacity: 1, y: 0 }, '-=0.6')
    .to('#hero-date',      { opacity: 1, y: 0 }, '-=0.6')
    .to('#hero-countdown', { opacity: 1, y: 0 }, '-=0.5')
    .to('#cal-wrap',       { opacity: 1, y: 0 }, '-=0.5');

  // ScrollTrigger para elementos futuros con gsap-fade-up
  gsap.utils.toArray(
    '.gsap-fade-up:not(#hero-pre):not(#hero-names):not(#hero-date):not(#hero-countdown):not(#cal-wrap)'
  ).forEach((el) => {
    gsap.to(el, {
      opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
      scrollTrigger: { trigger: el, start: 'top 85%' },
    });
  });

  // Toggle dropdown calendario
  const calBtn = document.getElementById('cal-btn');
  const calDropdown = document.getElementById('cal-dropdown');

  calBtn.addEventListener('click', () => {
    const isOpen = calDropdown.classList.toggle('open');
    calBtn.setAttribute('aria-expanded', String(isOpen));
  });

  // Cerrar al hacer clic fuera
  document.addEventListener('click', (e) => {
    if (!document.getElementById('cal-wrap').contains(e.target)) {
      calDropdown.classList.remove('open');
      calBtn.setAttribute('aria-expanded', 'false');
    }
  });

  // Descarga .ics
  document.getElementById('ics-download').addEventListener('click', (e) => {
    e.preventDefault();
    const ics = [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//Boda Alba & Antonio//ES',
      'BEGIN:VEVENT',
      'DTSTART:20270724T120000',
      'DTEND:20270724T235900',
      'SUMMARY:Boda Alba & Antonio',
      'DESCRIPTION:¡Nos casamos! Guarda este día especial.',
      'END:VEVENT',
      'END:VCALENDAR',
    ].join('\r\n');

    const blob = new Blob([ics], { type: 'text/calendar' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'boda-alba-antonio.ics';
    a.click();
    URL.revokeObjectURL(url);
  });
</script>
