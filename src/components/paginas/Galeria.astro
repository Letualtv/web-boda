---
import PaginaMarco from '../PaginaMarco.astro';
import GotasTinta from '../GotasTinta.astro';
import EnlaceSiguiente from '../EnlaceSiguiente.astro';
import LimonMini from '../LimonMini.astro';

// 8 huecos irregulares tipo álbum de recortes.
// Cuando subas fotos con nombres 01.jpg, 02.jpg… aparecerán solas.
const HUECOS = [
  { archivo: '01', tam: 'cuadrado',    rot: -2, tape: 'limon' },
  { archivo: '02', tam: 'vertical',    rot: 1.5, tape: 'oliva' },
  { archivo: '03', tam: 'horizontal',  rot: -1, tape: 'teja' },
  { archivo: '04', tam: 'cuadrado',    rot: 2.5, tape: 'limon' },
  { archivo: '05', tam: 'vertical',    rot: -1.5, tape: 'oliva' },
  { archivo: '06', tam: 'cuadrado',    rot: 1, tape: 'teja' },
  { archivo: '07', tam: 'horizontal',  rot: -2.5, tape: 'limon' },
  { archivo: '08', tam: 'cuadrado',    rot: 0.5, tape: 'oliva' },
];
---

<PaginaMarco titulo="Recuerdos" scroll>
  <GotasTinta slot="decoracion" variante={2} />
  <div class="galeria-inner">
    <h2 class="titulo">Recuerdos</h2>

    <div class="separador">
      <span class="linea"></span>
      <LimonMini tam={24} />
      <span class="linea"></span>
    </div>

    <p class="intro">
      Iremos añadiendo fotos según se acerque el día
      y también después, cuando ya lo hayamos vivido juntos.
    </p>

    <div class="album">
      {HUECOS.map(({ archivo, tam, rot, tape }) => (
        <figure
          class={`marco marco-${tam} tape-${tape}`}
          style={`transform: rotate(${rot}deg);`}
          data-archivo={archivo}
        >
          <div class="foto-wrap">
            <img
              class="foto"
              src={`/img/galeria/${archivo}.jpg`}
              alt=""
              loading="lazy"
              onerror="this.classList.add('vacio')"
            />
            <div class="placeholder-vacio" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
                <rect x="3" y="4" width="18" height="16" rx="2"/>
                <circle cx="9" cy="10" r="2"/>
                <path d="M21 16l-5-5-9 9"/>
              </svg>
            </div>
          </div>
        </figure>
      ))}
    </div>

    <EnlaceSiguiente href="/fin/" label="Fin" />
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox" aria-hidden="true">
    <button id="lightbox-cerrar" class="lightbox-cerrar" aria-label="Cerrar">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="6" y1="18" x2="18" y2="6"/>
      </svg>
    </button>
    <img id="lightbox-img" src="" alt="" />
  </div>
</PaginaMarco>

<style>
  .galeria-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    width: 100%;
    max-width: 800px;
  }

  .titulo {
    font-family: var(--font-brush);
    font-weight: 400;
    font-size: clamp(2.5rem, 7vw, 3.6rem);
    color: var(--color-tinta);
    line-height: 1;
    margin: 0;
  }

  .separador {
    display: flex; align-items: center; gap: 0.75rem;
    width: clamp(120px, 30vw, 180px);
    margin: 0.5rem 0 1rem;
  }
  .separador .linea {
    flex: 1; height: 1px;
    background: linear-gradient(to right, transparent, var(--color-teja), transparent);
  }

  .intro {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-tinta-clara);
    font-size: clamp(0.9rem, 2.2vw, 1rem);
    max-width: 440px;
    margin: 0 0 1.5rem;
  }

  /* ─── Álbum ────────────────────────────────────────── */
  .album {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 100px;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    width: 100%;
    padding: 1rem;
  }

  @media (max-width: 720px) {
    .album { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 90px; }
  }

  .marco {
    position: relative;
    background: #FDF9EE;
    padding: 8px 8px 32px;
    box-shadow: 0 2px 8px rgba(30, 58, 95, 0.12), 0 6px 24px rgba(30, 58, 95, 0.06);
    transition: transform 300ms ease, box-shadow 300ms ease;
    cursor: pointer;
  }
  .marco:hover {
    transform: rotate(0deg) scale(1.04) !important;
    box-shadow: 0 6px 20px rgba(30, 58, 95, 0.2);
    z-index: 5;
  }

  .marco-cuadrado   { grid-column: span 1; grid-row: span 2; }
  .marco-vertical   { grid-column: span 1; grid-row: span 3; }
  .marco-horizontal { grid-column: span 2; grid-row: span 2; }

  @media (max-width: 720px) {
    .marco-horizontal { grid-column: span 2; grid-row: span 2; }
    .marco-vertical   { grid-column: span 1; grid-row: span 3; }
  }

  .foto-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #E8DCC0;
  }

  .foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .foto.vacio { display: none; }
  .foto:not(.vacio) + .placeholder-vacio { display: none; }

  .placeholder-vacio {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(30, 58, 95, 0.25);
  }

  /* Washi tape */
  .marco::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%) rotate(-4deg);
    width: 40%;
    height: 16px;
    opacity: 0.75;
  }
  .tape-limon::before { background: rgba(212, 200, 74, 0.55); }
  .tape-oliva::before { background: rgba(107, 122, 62, 0.4); }
  .tape-teja::before  { background: rgba(196, 113, 79, 0.4); }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(10, 15, 25, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }
  .lightbox.abierto {
    opacity: 1;
    pointer-events: auto;
  }
  .lightbox img {
    max-width: 92vw;
    max-height: 88vh;
    object-fit: contain;
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
  }
  .lightbox-cerrar {
    position: absolute;
    top: clamp(1rem, 3vh, 1.75rem);
    right: clamp(1rem, 3vw, 1.75rem);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(243, 233, 210, 0.2);
    border: 1px solid rgba(243, 233, 210, 0.3);
    color: #F3E9D2;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 250ms ease;
  }
  .lightbox-cerrar:hover { background: rgba(243, 233, 210, 0.35); }
</style>

<script>
  const marcos = document.querySelectorAll<HTMLElement>('.album .marco');
  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCerrar = document.getElementById('lightbox-cerrar') as HTMLElement;

  function abrir(src: string) {
    lightboxImg.src = src;
    lightbox.classList.add('abierto');
    lightbox.setAttribute('aria-hidden', 'false');
  }
  function cerrar() {
    lightbox.classList.remove('abierto');
    lightbox.setAttribute('aria-hidden', 'true');
    setTimeout(() => { lightboxImg.src = ''; }, 300);
  }

  marcos.forEach((marco) => {
    marco.addEventListener('click', () => {
      const foto = marco.querySelector<HTMLImageElement>('.foto');
      if (!foto || foto.classList.contains('vacio')) return;
      abrir(foto.src);
    });
  });

  lightboxCerrar.addEventListener('click', cerrar);
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) cerrar();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox.classList.contains('abierto')) cerrar();
  });
</script>
