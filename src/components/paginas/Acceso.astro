---
import PaginaMarco from '../PaginaMarco.astro';
const PASSWORD = 'genilla2027';
---

<PaginaMarco titulo="Acceso" esquinaSupDer="/img/svg/esquinas/olivo-sup-der.svg">
  <div class="acceso-inner">
    <h2 class="titulo">Palabra de entrada</h2>

    <p class="instrucciones">Escríbela con calma…</p>

    <form id="form-acceso" class="tinta-contenedor vacio" data-password={PASSWORD} novalidate>
      <!-- input real invisible pero accesible -->
      <input
        id="pwd-real"
        type="text"
        autocomplete="off"
        autocapitalize="none"
        autocorrect="off"
        spellcheck="false"
        aria-label="Palabra de entrada"
        class="pwd-real"
      />

      <div class="linea-escritura">
        <!-- placeholder cuando vacío -->
        <span class="placeholder">Escríbela aquí</span>

        <!-- display visible caligráfico -->
        <div class="tinta-display" id="tinta-display" aria-hidden="true"></div>

        <!-- cursor pluma -->
        <span class="pluma" id="pluma">
          <svg viewBox="0 0 24 32" width="20" height="28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- cuerpo de pluma -->
            <path d="M4 28 L18 4 L22 6 L8 30 Z" fill="#1E3A5F" fill-opacity="0.9" stroke="#1E3A5F" stroke-width="0.8" stroke-linejoin="round"/>
            <!-- punta metálica -->
            <path d="M4 28 L8 30 L6 26 Z" fill="#0f2338"/>
            <!-- reflejo -->
            <line x1="16" y1="8" x2="7" y2="26" stroke="#F3E9D2" stroke-width="0.7" stroke-linecap="round" opacity="0.6"/>
          </svg>
        </span>

        <!-- línea inferior tipo cuaderno -->
        <span class="linea-cuaderno"></span>

        <!-- contenedor de gotitas -->
        <div class="gotitas" id="gotitas" aria-hidden="true"></div>
      </div>

      <!-- botón sello -->
      <button type="submit" class="btn-sello" id="btn-entrar" disabled>
        <span class="sello-inner">
          <span class="sello-monograma">A &amp; A</span>
          <span class="sello-label">Entrar</span>
        </span>
      </button>

      <p class="mensaje-error" id="mensaje-error">esta no es la palabra</p>
    </form>

    <p class="nota">Pregúntanos si no la recuerdas</p>
  </div>

  <!-- ─── Overlay épico al acertar ─────────────────────── -->
  <div id="epic-overlay" class="epic-overlay" aria-hidden="true">
    <!-- Sello de lacre que baja -->
    <div class="epic-sello">
      <div class="epic-sello-inner">
        <span class="epic-monograma">A &amp; A</span>
        <span class="epic-label">Bienvenido</span>
      </div>
      <div class="epic-sello-goteo" aria-hidden="true"></div>
    </div>

    <!-- Ondas expansivas -->
    <div class="epic-onda epic-onda-1"></div>
    <div class="epic-onda epic-onda-2"></div>
    <div class="epic-onda epic-onda-3"></div>

    <!-- Pétalos/hojas de olivo -->
    <div class="epic-particulas" id="epic-particulas"></div>

    <!-- Fundido final dorado -->
    <div class="epic-fundido"></div>
  </div>
</PaginaMarco>

<style>
  .acceso-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1rem, 3vh, 1.5rem);
    width: 100%;
    max-width: 520px;
    text-align: center;
  }

  .titulo {
    font-family: var(--font-brush);
    font-weight: 400;
    font-size: clamp(2.2rem, 7vw, 3.4rem);
    color: var(--color-tinta);
    line-height: 1;
    margin: 0;
  }

  .instrucciones {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-tinta-clara);
    font-size: clamp(0.85rem, 2vw, 1rem);
    margin: 0;
  }

  /* ─── Contenedor global ─────────────────────────────── */
  .tinta-contenedor {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    margin: 1rem 0;
  }

  /* ─── Input real invisible ──────────────────────────── */
  .pwd-real {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100px;
    opacity: 0;
    border: none;
    background: transparent;
    font-size: 16px;
    z-index: 10;
    cursor: text;
  }

  /* ─── Línea de escritura ────────────────────────────── */
  .linea-escritura {
    position: relative;
    width: 100%;
    height: 100px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .placeholder {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-serif);
    font-style: italic;
    color: rgba(30, 58, 95, 0.4);
    font-size: clamp(0.95rem, 2.4vw, 1.1rem);
    letter-spacing: 0.08em;
    pointer-events: none;
    transition: opacity 300ms ease;
    z-index: 2;
    white-space: nowrap;
    max-width: 90%;
    text-align: center;
  }
  .tinta-contenedor:not(.vacio) .placeholder,
  .tinta-contenedor.con-foco .placeholder { opacity: 0; }

  /* ─── Display caligráfico ───────────────────────────── */
  .tinta-display {
    position: relative;
    font-family: var(--font-brush);
    color: var(--color-tinta);
    font-size: clamp(2.2rem, 7vw, 3.4rem);
    letter-spacing: 0.08em;
    line-height: 1;
    text-align: center;
    z-index: 3;
    padding: 0 30px 8px;
    min-height: 3.6rem;
    max-width: 100%;
    display: inline-flex;
    align-items: flex-end;
    flex-wrap: wrap;
    justify-content: center;
    transition: color 400ms ease;
  }

  /* ─── Cada carácter — entra como tinta fluyendo ────────
     Inicio: invisible + ligeramente comprimido + con "aura" difusa (text-shadow expandido).
     Final: opaco + tamaño real + shadow colapsado (tinta absorbida por el papel).
  ──────────────────────────────────────────────────────── */
  .tinta-display :global(.char) {
    display: inline-block;
    opacity: 0;
    transform: translateY(3px) scaleY(0.85);
    color: transparent;
    text-shadow:
      0 0 8px rgba(30, 58, 95, 0.55),
      0 0 3px rgba(30, 58, 95, 0.7);
    transition:
      opacity 450ms cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 520ms cubic-bezier(0.22, 0.61, 0.36, 1),
      color 520ms cubic-bezier(0.22, 0.61, 0.36, 1) 60ms,
      text-shadow 600ms cubic-bezier(0.4, 0, 0.6, 1) 120ms;
    transform-origin: 50% 90%;
  }
  .tinta-display :global(.char.entrando) {
    opacity: 1;
    transform: translateY(0) scaleY(1);
    color: var(--color-tinta);
    text-shadow:
      0 0 0.5px rgba(30, 58, 95, 0.25),
      0 1px 0 rgba(30, 58, 95, 0.05);
  }

  /* ─── Pluma cursor ──────────────────────────────────── */
  .pluma {
    position: absolute;
    top: 0;
    left: 0;
    width: 20px;
    height: 28px;
    pointer-events: none;
    z-index: 4;
    transition: transform 100ms ease-out;
    transform-origin: 30% 90%;
    opacity: 0;
  }
  .tinta-contenedor.con-foco .pluma { opacity: 1; }
  .tinta-contenedor.escribiendo .pluma {
    animation: pluma-rotar 200ms ease-in-out infinite alternate;
  }
  @keyframes pluma-rotar {
    from { rotate: -3deg; }
    to   { rotate:  3deg; }
  }

  /* ─── Línea inferior ────────────────────────────────── */
  .linea-cuaderno {
    position: absolute;
    bottom: 0;
    left: 8%;
    right: 8%;
    height: 1px;
    background: var(--color-tinta-clara);
    opacity: 0.35;
    transition: opacity 400ms ease, background 400ms ease;
  }
  .tinta-contenedor.con-foco .linea-cuaderno { opacity: 0.65; }

  /* ─── Contenedor gotitas ────────────────────────────── */
  .gotitas {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    z-index: 2;
  }
  .gotitas :global(.gotita) {
    position: absolute;
    background: var(--color-tinta);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 0 2px rgba(30, 58, 95, 0.25);
  }

  /* ─── Botón sello ───────────────────────────────────── */
  .btn-sello {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    opacity: 0.35;
    pointer-events: none;
    transition:
      opacity 500ms ease,
      transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
    transform: scale(0.9);
  }
  .tinta-contenedor.tiene-texto .btn-sello {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
  }

  .sello-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%,
      rgba(196, 113, 79, 0.95) 0%,
      rgba(158, 82, 55, 0.98) 55%,
      rgba(122, 60, 40, 1) 100%);
    color: #F3E9D2;
    box-shadow:
      inset 0 2px 3px rgba(255, 240, 220, 0.35),
      inset 0 -3px 6px rgba(50, 20, 10, 0.4),
      0 3px 8px rgba(30, 58, 95, 0.25),
      0 1px 2px rgba(30, 58, 95, 0.15);
    position: relative;
    transition: transform 250ms ease, box-shadow 250ms ease;
  }
  /* Doble círculo interior tipo sello grabado */
  .sello-inner::before {
    content: '';
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    border: 1px solid rgba(243, 233, 210, 0.5);
    pointer-events: none;
  }
  .sello-inner::after {
    content: '';
    position: absolute;
    inset: 12px;
    border-radius: 50%;
    border: 1px dashed rgba(243, 233, 210, 0.25);
    pointer-events: none;
  }

  .btn-sello:hover .sello-inner {
    transform: rotate(-4deg) scale(1.05);
    box-shadow:
      inset 0 2px 3px rgba(255, 240, 220, 0.4),
      inset 0 -3px 6px rgba(50, 20, 10, 0.45),
      0 6px 14px rgba(30, 58, 95, 0.3),
      0 2px 4px rgba(30, 58, 95, 0.15);
  }
  .btn-sello:active .sello-inner {
    transform: rotate(-4deg) scale(0.98);
  }

  .sello-monograma {
    font-family: var(--font-vibes);
    font-size: 2.1rem;
    line-height: 1;
    color: #F3E9D2;
    text-shadow: 0 1px 2px rgba(50, 20, 10, 0.5);
    z-index: 1;
  }
  .sello-label {
    font-family: var(--font-sans);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: rgba(243, 233, 210, 0.85);
    z-index: 1;
    margin-top: 0.1rem;
  }

  /* ─── Estados: error / correcto ─────────────────────── */
  .mensaje-error {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-vino);
    font-size: 0.95rem;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
    min-height: 1.2em;
  }
  .tinta-contenedor.error .mensaje-error { opacity: 1; }

  .tinta-contenedor.error .tinta-display { color: var(--color-vino); }
  .tinta-contenedor.error .linea-cuaderno { background: var(--color-vino); opacity: 0.6; }

  .tinta-contenedor.error {
    animation: temblor 400ms ease-in-out 2;
  }
  @keyframes temblor {
    0%, 100% { transform: translateX(0); }
    25%      { transform: translateX(-6px); }
    75%      { transform: translateX(6px); }
  }

  .tinta-contenedor.correcto {
    filter: saturate(0.7);
    transition: filter 500ms ease;
  }

  .nota {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-tinta-clara);
    font-size: clamp(0.8rem, 1.9vw, 0.95rem);
    opacity: 0.7;
    margin: 0;
  }

  /* ═════════════════════════════════════════════════════
     ANIMACIÓN ÉPICA AL ACERTAR
  ═════════════════════════════════════════════════════ */
  .epic-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }
  .epic-overlay.activa {
    opacity: 1;
    visibility: visible;
  }

  /* ─── Sello de lacre que baja ────────────────────────── */
  .epic-sello {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 180px;
    height: 180px;
    transform: translate(-50%, -50%) translateY(-100vh) rotate(-25deg) scale(0.6);
    opacity: 0;
  }
  .epic-overlay.activa .epic-sello {
    animation: sello-caer 900ms cubic-bezier(0.65, 0, 0.35, 1.4) 100ms forwards;
  }
  @keyframes sello-caer {
    0%   { transform: translate(-50%, -50%) translateY(-100vh) rotate(-25deg) scale(0.6); opacity: 0; }
    55%  { transform: translate(-50%, -50%) translateY(0) rotate(-8deg) scale(1.15); opacity: 1; }
    72%  { transform: translate(-50%, -50%) translateY(0) rotate(-6deg) scale(0.95); opacity: 1; }
    100% { transform: translate(-50%, -50%) translateY(0) rotate(-6deg) scale(1); opacity: 1; }
  }

  .epic-sello-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    background: radial-gradient(circle at 32% 28%,
      rgba(196, 113, 79, 0.98) 0%,
      rgba(158, 82, 55, 1) 55%,
      rgba(100, 45, 25, 1) 100%);
    color: #F3E9D2;
    box-shadow:
      inset 0 3px 6px rgba(255, 240, 220, 0.4),
      inset 0 -6px 12px rgba(50, 20, 10, 0.5),
      0 8px 24px rgba(50, 20, 10, 0.5),
      0 3px 8px rgba(30, 20, 10, 0.3);
    position: relative;
  }
  .epic-sello-inner::before {
    content: '';
    position: absolute;
    inset: 14px;
    border-radius: 50%;
    border: 1.5px solid rgba(243, 233, 210, 0.5);
    pointer-events: none;
  }
  .epic-sello-inner::after {
    content: '';
    position: absolute;
    inset: 20px;
    border-radius: 50%;
    border: 1px dashed rgba(243, 233, 210, 0.3);
    pointer-events: none;
  }

  .epic-monograma {
    font-family: var(--font-vibes);
    font-size: 3.5rem;
    line-height: 1;
    text-shadow: 0 2px 3px rgba(50, 20, 10, 0.6);
  }
  .epic-label {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(243, 233, 210, 0.85);
    margin-top: 0.2rem;
  }

  /* Goteo alrededor del sello */
  .epic-sello-goteo {
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    background: radial-gradient(circle,
      rgba(158, 82, 55, 0.35) 45%,
      transparent 65%);
    filter: blur(6px);
    opacity: 0;
  }
  .epic-overlay.activa .epic-sello-goteo {
    animation: goteo-aparecer 400ms ease-out 700ms forwards;
  }
  @keyframes goteo-aparecer {
    from { opacity: 0; transform: scale(0.8); }
    to   { opacity: 1; transform: scale(1.15); }
  }

  /* ─── Ondas expansivas concéntricas ─────────────────── */
  .epic-onda {
    position: absolute;
    top: 50%; left: 50%;
    width: 200px;
    height: 200px;
    margin: -100px 0 0 -100px;
    border: 2px solid var(--color-teja);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.3);
  }
  .epic-overlay.activa .epic-onda-1 { animation: onda 1.6s ease-out 700ms forwards; }
  .epic-overlay.activa .epic-onda-2 { animation: onda 1.6s ease-out 850ms forwards; }
  .epic-overlay.activa .epic-onda-3 { animation: onda 1.6s ease-out 1000ms forwards; }
  @keyframes onda {
    0%   { opacity: 0.7; transform: scale(0.3); border-width: 3px; }
    100% { opacity: 0; transform: scale(6); border-width: 0.5px; }
  }

  /* ─── Partículas (pétalos y gotas) ──────────────────── */
  .epic-particulas {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .epic-particulas :global(.particula) {
    position: absolute;
    top: 50%; left: 50%;
    pointer-events: none;
    will-change: transform, opacity;
  }
  .epic-particulas :global(.p-hoja) {
    width: 12px;
    height: 6px;
    border-radius: 50% 10% 50% 10%;
    background: var(--color-oliva);
  }
  .epic-particulas :global(.p-gota) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-limon);
    box-shadow: 0 0 6px rgba(212, 200, 74, 0.8);
  }
  .epic-particulas :global(.p-teja) {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-teja);
    opacity: 0.85;
  }

  /* ─── Fundido dorado antes del redirect ─────────────── */
  .epic-fundido {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center,
      rgba(212, 200, 74, 0.15) 0%,
      rgba(196, 113, 79, 0.35) 45%,
      rgba(30, 20, 10, 0.85) 100%);
    opacity: 0;
  }
  .epic-overlay.activa .epic-fundido {
    animation: fundido-final 700ms ease-in 2100ms forwards;
  }
  @keyframes fundido-final {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .epic-overlay.activa .epic-sello,
    .epic-overlay.activa .epic-onda,
    .epic-overlay.activa .epic-fundido {
      animation-duration: 300ms !important;
    }
  }
</style>

<script>
  import { crearTintaEscritura } from '../efectos/TintaEscritura';

  const BASE_URL = import.meta.env.BASE_URL;
  const DESTINO = (BASE_URL + 'bienvenida/').replace(/\/+/g, '/');

  const contenedor = document.getElementById('form-acceso') as HTMLFormElement;
  const inputReal = document.getElementById('pwd-real') as HTMLInputElement;
  const display = document.getElementById('tinta-display') as HTMLElement;
  const pluma = document.getElementById('pluma') as HTMLElement;
  const gotitas = document.getElementById('gotitas') as HTMLElement;
  const btnEntrar = document.getElementById('btn-entrar') as HTMLButtonElement;
  const epic = document.getElementById('epic-overlay') as HTMLElement;
  const particulas = document.getElementById('epic-particulas') as HTMLElement;

  // Si ya está autenticado, redirigir directo
  if (sessionStorage.getItem('boda_auth') === 'ok') {
    window.location.replace(DESTINO);
  }

  function lanzarEpica() {
    if (!epic || !particulas) return;
    // Generar 40-50 partículas en direcciones aleatorias
    const total = 48;
    for (let i = 0; i < total; i++) {
      const p = document.createElement('span');
      const tipo = i % 3 === 0 ? 'p-gota' : (i % 3 === 1 ? 'p-hoja' : 'p-teja');
      p.className = `particula ${tipo}`;
      const angulo = (Math.PI * 2 * i) / total + Math.random() * 0.3;
      const distancia = 200 + Math.random() * 400;
      const dx = Math.cos(angulo) * distancia;
      const dy = Math.sin(angulo) * distancia;
      const rot = (Math.random() - 0.5) * 720;
      const dur = 1200 + Math.random() * 600;
      const delay = 700 + Math.random() * 200;
      p.style.transition = `transform ${dur}ms cubic-bezier(0.22, 0.61, 0.36, 1) ${delay}ms, opacity ${dur}ms ease-out ${delay}ms`;
      p.style.transform = 'translate(-50%, -50%) rotate(0deg)';
      p.style.opacity = '1';
      particulas.appendChild(p);
      // reflow + trigger
      void p.offsetWidth;
      requestAnimationFrame(() => {
        p.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) rotate(${rot}deg)`;
        p.style.opacity = '0';
      });
    }
    epic.classList.add('activa');
    epic.setAttribute('aria-hidden', 'false');
  }

  if (contenedor && inputReal && display && pluma && gotitas && btnEntrar) {
    const password = contenedor.dataset.password || '';

    const tinta = crearTintaEscritura({
      contenedor,
      inputReal,
      displayVisible: display,
      pluma,
      gotitas,
      password,
      onCorrecto: () => {
        sessionStorage.setItem('boda_auth', 'ok');
        lanzarEpica();
        // Redirigir tras la animación completa (~2.8s)
        setTimeout(() => {
          window.location.href = DESTINO;
        }, 2800);
      },
      onError: () => { /* clase .error ya aplicada por el motor */ },
    });

    inputReal.addEventListener('input', () => {
      if (inputReal.value.length >= 3) {
        contenedor.classList.add('tiene-texto');
        btnEntrar.disabled = false;
      } else {
        contenedor.classList.remove('tiene-texto');
        btnEntrar.disabled = true;
      }
    });

    contenedor.addEventListener('submit', (e) => {
      e.preventDefault();
      if (inputReal.value.length >= 3) tinta.verificar();
    });
  }
</script>
