---
import PaginaMarco from '../PaginaMarco.astro';
const PASSWORD = 'genilla2027';
---

<PaginaMarco titulo="Acceso" esquinaSupDer="/img/svg/esquinas/olivo-sup-der.svg">
  <div class="acceso-inner">
    <h2 class="titulo">Palabra de entrada</h2>

    <p class="instrucciones">Escríbela con calma…</p>

    <form id="form-acceso" class="tinta-contenedor vacio" data-password={PASSWORD} novalidate>
      <!-- input real invisible pero accesible -->
      <input
        id="pwd-real"
        type="text"
        autocomplete="off"
        autocapitalize="none"
        autocorrect="off"
        spellcheck="false"
        aria-label="Palabra de entrada"
        class="pwd-real"
      />

      <div class="linea-escritura">
        <!-- placeholder cuando vacío -->
        <span class="placeholder">Escríbela aquí</span>

        <!-- display visible caligráfico -->
        <div class="tinta-display" id="tinta-display" aria-hidden="true"></div>

        <!-- cursor pluma -->
        <span class="pluma" id="pluma">
          <svg viewBox="0 0 24 32" width="20" height="28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- cuerpo de pluma -->
            <path d="M4 28 L18 4 L22 6 L8 30 Z" fill="#1E3A5F" fill-opacity="0.9" stroke="#1E3A5F" stroke-width="0.8" stroke-linejoin="round"/>
            <!-- punta metálica -->
            <path d="M4 28 L8 30 L6 26 Z" fill="#0f2338"/>
            <!-- reflejo -->
            <line x1="16" y1="8" x2="7" y2="26" stroke="#F3E9D2" stroke-width="0.7" stroke-linecap="round" opacity="0.6"/>
          </svg>
        </span>

        <!-- línea inferior tipo cuaderno -->
        <span class="linea-cuaderno"></span>

        <!-- contenedor de gotitas -->
        <div class="gotitas" id="gotitas" aria-hidden="true"></div>
      </div>

      <!-- botón entrar simple -->
      <button type="submit" class="btn-entrar" id="btn-entrar" disabled>
        Entrar
      </button>

      <p class="mensaje-error" id="mensaje-error">esta no es la palabra</p>
    </form>

    <p class="nota">Pregúntanos si no la recuerdas</p>
  </div>

  <!-- ─── Overlay épico al acertar ─────────────────────── -->
  <div id="epic-overlay" class="epic-overlay" aria-hidden="true">
    <!-- Sello de lacre que baja -->
    <div class="epic-sello">
      <div class="epic-sello-inner">
        <span class="epic-monograma">A &amp; A</span>
        <span class="epic-label">Bienvenido</span>
      </div>
      <div class="epic-sello-goteo" aria-hidden="true"></div>
    </div>

    <!-- Ondas expansivas -->
    <div class="epic-onda epic-onda-1"></div>
    <div class="epic-onda epic-onda-2"></div>
    <div class="epic-onda epic-onda-3"></div>

    <!-- Pétalos/hojas de olivo -->
    <div class="epic-particulas" id="epic-particulas"></div>

    <!-- Fundido final dorado -->
    <div class="epic-fundido"></div>
  </div>
</PaginaMarco>

<style>
  .acceso-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1rem, 3vh, 1.5rem);
    width: 100%;
    max-width: 520px;
    text-align: center;
  }

  .titulo {
    font-family: var(--font-brush);
    font-weight: 400;
    font-size: clamp(2.2rem, 7vw, 3.4rem);
    color: var(--color-tinta);
    line-height: 1;
    margin: 0;
  }

  .instrucciones {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-tinta-clara);
    font-size: clamp(0.85rem, 2vw, 1rem);
    margin: 0;
  }

  /* ─── Contenedor global ─────────────────────────────── */
  .tinta-contenedor {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    margin: 1rem 0;
  }

  /* ─── Input real invisible ──────────────────────────── */
  .pwd-real {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100px;
    opacity: 0;
    border: none;
    background: transparent;
    font-size: 16px;
    z-index: 10;
    cursor: text;
  }

  /* ─── Línea de escritura ────────────────────────────── */
  .linea-escritura {
    position: relative;
    width: 100%;
    height: 100px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .placeholder {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-serif);
    font-style: italic;
    color: rgba(30, 58, 95, 0.4);
    font-size: clamp(0.95rem, 2.4vw, 1.1rem);
    letter-spacing: 0.08em;
    pointer-events: none;
    transition: opacity 300ms ease;
    z-index: 2;
    white-space: nowrap;
    max-width: 90%;
    text-align: center;
  }
  .tinta-contenedor:not(.vacio) .placeholder,
  .tinta-contenedor.con-foco .placeholder { opacity: 0; }

  /* ─── Display caligráfico ───────────────────────────── */
  .tinta-display {
    position: relative;
    font-family: var(--font-brush);
    color: var(--color-tinta);
    font-size: clamp(2.2rem, 7vw, 3.4rem);
    letter-spacing: 0.08em;
    line-height: 1;
    text-align: center;
    z-index: 3;
    padding: 0 30px 8px;
    min-height: 3.6rem;
    max-width: 100%;
    display: inline-flex;
    align-items: flex-end;
    flex-wrap: wrap;
    justify-content: center;
    transition: color 400ms ease;
  }

  /* ─── Cada carácter — tinta fresca que se seca ────────
     Inicio: casi invisible, difuminado (blur simula tinta mojada
     esparciéndose sobre el papel), color claro.
     Final: nítido, opacidad plena, tono tinta profunda (tinta seca).
  ──────────────────────────────────────────────────────── */
  .tinta-display :global(.char) {
    display: inline-block;
    opacity: 0;
    filter: blur(5px);
    transform: translateY(2px);
    color: var(--color-tinta-clara);
    transition:
      opacity 400ms cubic-bezier(0.22, 0.61, 0.36, 1),
      filter 550ms cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 500ms cubic-bezier(0.22, 0.61, 0.36, 1),
      color 700ms ease 100ms;
  }
  .tinta-display :global(.char.entrando) {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
    color: var(--color-tinta);
  }

  /* ─── Pluma cursor ──────────────────────────────────── */
  .pluma {
    position: absolute;
    top: 0;
    left: 0;
    width: 20px;
    height: 28px;
    pointer-events: none;
    z-index: 4;
    transition: transform 100ms ease-out;
    transform-origin: 30% 90%;
    opacity: 0;
  }
  .tinta-contenedor.con-foco .pluma { opacity: 1; }
  .tinta-contenedor.escribiendo .pluma {
    animation: pluma-rotar 200ms ease-in-out infinite alternate;
  }
  @keyframes pluma-rotar {
    from { rotate: -3deg; }
    to   { rotate:  3deg; }
  }

  /* ─── Línea inferior ────────────────────────────────── */
  .linea-cuaderno {
    position: absolute;
    bottom: 0;
    left: 8%;
    right: 8%;
    height: 1px;
    background: var(--color-tinta-clara);
    opacity: 0.35;
    transition: opacity 400ms ease, background 400ms ease;
  }
  .tinta-contenedor.con-foco .linea-cuaderno { opacity: 0.65; }

  /* ─── Contenedor gotitas ────────────────────────────── */
  .gotitas {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    z-index: 2;
  }
  .gotitas :global(.gotita) {
    position: absolute;
    background: var(--color-tinta);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 0 2px rgba(30, 58, 95, 0.25);
  }

  /* ─── Botón entrar — simple, elegante ─────────────── */
  .btn-entrar {
    background: transparent;
    border: 1px solid rgba(30, 58, 95, 0.45);
    color: var(--color-tinta);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    padding: 0.95rem 3rem;
    cursor: pointer;
    opacity: 0.4;
    pointer-events: none;
    transition:
      opacity 400ms ease,
      background 250ms ease,
      border-color 250ms ease,
      color 250ms ease,
      transform 200ms ease;
  }
  .tinta-contenedor.tiene-texto .btn-entrar {
    opacity: 1;
    pointer-events: auto;
  }
  .btn-entrar:hover {
    background: rgba(30, 58, 95, 0.06);
    border-color: var(--color-tinta);
  }
  .btn-entrar:active { transform: scale(0.97); }
  .btn-entrar:disabled { cursor: default; }

  /* ─── Estados: error / correcto ─────────────────────── */
  .mensaje-error {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-vino);
    font-size: 0.95rem;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
    min-height: 1.2em;
  }
  .tinta-contenedor.error .mensaje-error { opacity: 1; }

  .tinta-contenedor.error .tinta-display { color: var(--color-vino); }
  .tinta-contenedor.error .linea-cuaderno { background: var(--color-vino); opacity: 0.6; }

  .tinta-contenedor.error {
    animation: temblor 400ms ease-in-out 2;
  }
  @keyframes temblor {
    0%, 100% { transform: translateX(0); }
    25%      { transform: translateX(-6px); }
    75%      { transform: translateX(6px); }
  }

  .tinta-contenedor.correcto {
    filter: saturate(0.7);
    transition: filter 500ms ease;
  }

  .nota {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-tinta-clara);
    font-size: clamp(0.8rem, 1.9vw, 0.95rem);
    opacity: 0.7;
    margin: 0;
  }

  /* ═════════════════════════════════════════════════════
     ANIMACIÓN ÉPICA AL ACERTAR
  ═════════════════════════════════════════════════════ */
  .epic-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    background: rgba(45, 35, 25, 0);
    transition: background 500ms ease;
    visibility: hidden;
  }
  .epic-overlay.activa {
    background: rgba(45, 35, 25, 0.75);   /* fondo gris oscuro para destacar el sello */
    visibility: visible;
    backdrop-filter: blur(2px);
  }

  /* ─── Sello de lacre que baja y se estampa ───────────── */
  .epic-sello {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 200px;
    height: 200px;
    transform: translate(-50%, -50%) translateY(-100vh) rotate(-25deg) scale(0.6);
    opacity: 0;
    z-index: 2;
  }
  .epic-overlay.activa .epic-sello {
    animation: sello-caer 950ms cubic-bezier(0.55, 0, 0.35, 1) 200ms forwards;
  }
  @keyframes sello-caer {
    /* Caída fuerte desde arriba */
    0%   { transform: translate(-50%, -50%) translateY(-100vh) rotate(-25deg) scale(0.55); opacity: 0; }
    35%  { transform: translate(-50%, -50%) translateY(-30vh) rotate(-18deg) scale(0.7); opacity: 0.5; }
    /* Impacto — golpe seco, escala máxima */
    62%  { transform: translate(-50%, -50%) translateY(0) rotate(-6deg) scale(1.18); opacity: 1; }
    /* Rebote hacia arriba */
    75%  { transform: translate(-50%, -50%) translateY(-8px) rotate(-4deg) scale(0.96); }
    /* Asentado final */
    90%  { transform: translate(-50%, -50%) translateY(0) rotate(-5deg) scale(1.02); }
    100% { transform: translate(-50%, -50%) translateY(0) rotate(-5deg) scale(1); opacity: 1; }
  }

  .epic-sello-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    background: radial-gradient(circle at 32% 28%,
      rgba(196, 113, 79, 0.98) 0%,
      rgba(158, 82, 55, 1) 55%,
      rgba(100, 45, 25, 1) 100%);
    color: #F3E9D2;
    /* Relieve — arranca plano y crece al momento del impacto */
    box-shadow:
      inset 0 3px 6px rgba(255, 240, 220, 0.4),
      inset 0 -6px 12px rgba(50, 20, 10, 0.5),
      0 2px 4px rgba(30, 20, 10, 0.3);
    position: relative;
    transition: box-shadow 350ms cubic-bezier(0.34, 1.5, 0.64, 1);
  }
  /* Relieve profundo cuando termina de estamparse */
  .epic-overlay.activa .epic-sello-inner {
    animation: sello-relieve 350ms cubic-bezier(0.34, 1.5, 0.64, 1) 750ms forwards;
  }
  @keyframes sello-relieve {
    to {
      box-shadow:
        inset 0 4px 8px rgba(255, 240, 220, 0.5),
        inset 0 -8px 18px rgba(50, 20, 10, 0.6),
        /* sombra proyectada gruesa — el sello se ha "hundido" en el papel */
        0 22px 40px rgba(30, 20, 10, 0.55),
        0 8px 16px rgba(30, 20, 10, 0.45),
        0 3px 6px rgba(30, 20, 10, 0.35),
        /* halo cálido alrededor del sello */
        0 0 60px rgba(196, 113, 79, 0.4);
    }
  }
  .epic-sello-inner::before {
    content: '';
    position: absolute;
    inset: 14px;
    border-radius: 50%;
    border: 1.5px solid rgba(243, 233, 210, 0.5);
    pointer-events: none;
  }
  .epic-sello-inner::after {
    content: '';
    position: absolute;
    inset: 20px;
    border-radius: 50%;
    border: 1px dashed rgba(243, 233, 210, 0.3);
    pointer-events: none;
  }

  .epic-monograma {
    font-family: var(--font-vibes);
    font-size: 3.5rem;
    line-height: 1;
    text-shadow: 0 2px 3px rgba(50, 20, 10, 0.6);
  }
  .epic-label {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(243, 233, 210, 0.85);
    margin-top: 0.2rem;
  }

  /* Goteo cálido alrededor del sello, aparece con el impacto */
  .epic-sello-goteo {
    position: absolute;
    inset: -20px;
    border-radius: 50%;
    background: radial-gradient(circle,
      rgba(158, 82, 55, 0.45) 40%,
      transparent 65%);
    filter: blur(8px);
    opacity: 0;
  }
  .epic-overlay.activa .epic-sello-goteo {
    animation: goteo-aparecer 500ms ease-out 800ms forwards;
  }
  @keyframes goteo-aparecer {
    from { opacity: 0; transform: scale(0.7); }
    to   { opacity: 1; transform: scale(1.2); }
  }

  /* ─── Ondas expansivas concéntricas al impacto ─────── */
  .epic-onda {
    position: absolute;
    top: 50%; left: 50%;
    width: 220px;
    height: 220px;
    margin: -110px 0 0 -110px;
    border: 2px solid var(--color-teja);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.3);
  }
  .epic-overlay.activa .epic-onda-1 { animation: onda 1.8s ease-out 800ms forwards; }
  .epic-overlay.activa .epic-onda-2 { animation: onda 1.8s ease-out 950ms forwards; }
  .epic-overlay.activa .epic-onda-3 { animation: onda 1.8s ease-out 1100ms forwards; }
  @keyframes onda {
    0%   { opacity: 0.8; transform: scale(0.35); border-width: 3px; }
    100% { opacity: 0; transform: scale(6); border-width: 0.5px; }
  }

  /* ─── Partículas (pétalos y gotas) ──────────────────── */
  .epic-particulas {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .epic-particulas :global(.particula) {
    position: absolute;
    top: 50%; left: 50%;
    pointer-events: none;
    will-change: transform, opacity;
  }
  .epic-particulas :global(.p-hoja) {
    width: 12px;
    height: 6px;
    border-radius: 50% 10% 50% 10%;
    background: var(--color-oliva);
  }
  .epic-particulas :global(.p-gota) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-limon);
    box-shadow: 0 0 6px rgba(212, 200, 74, 0.8);
  }
  .epic-particulas :global(.p-teja) {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-teja);
    opacity: 0.85;
  }

  /* ─── Fundido dorado antes del redirect ─────────────── */
  .epic-fundido {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center,
      rgba(212, 200, 74, 0.15) 0%,
      rgba(196, 113, 79, 0.35) 45%,
      rgba(30, 20, 10, 0.85) 100%);
    opacity: 0;
  }
  .epic-overlay.activa .epic-fundido {
    animation: fundido-final 700ms ease-in 2100ms forwards;
  }
  @keyframes fundido-final {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .epic-overlay.activa .epic-sello,
    .epic-overlay.activa .epic-onda,
    .epic-overlay.activa .epic-fundido {
      animation-duration: 300ms !important;
    }
  }
</style>

<script>
  import { crearTintaEscritura } from '../efectos/TintaEscritura';

  const BASE_URL = import.meta.env.BASE_URL;
  const DESTINO = (BASE_URL + 'bienvenida/').replace(/\/+/g, '/');

  const contenedor = document.getElementById('form-acceso') as HTMLFormElement;
  const inputReal = document.getElementById('pwd-real') as HTMLInputElement;
  const display = document.getElementById('tinta-display') as HTMLElement;
  const pluma = document.getElementById('pluma') as HTMLElement;
  const gotitas = document.getElementById('gotitas') as HTMLElement;
  const btnEntrar = document.getElementById('btn-entrar') as HTMLButtonElement;
  const epic = document.getElementById('epic-overlay') as HTMLElement;
  const particulas = document.getElementById('epic-particulas') as HTMLElement;

  // Si ya está autenticado, redirigir directo
  if (sessionStorage.getItem('boda_auth') === 'ok') {
    window.location.replace(DESTINO);
  }

  function lanzarEpica() {
    if (!epic || !particulas) return;
    // Generar partículas que explotan al momento del impacto del sello (~800ms)
    const total = 48;
    for (let i = 0; i < total; i++) {
      const p = document.createElement('span');
      const tipo = i % 3 === 0 ? 'p-gota' : (i % 3 === 1 ? 'p-hoja' : 'p-teja');
      p.className = `particula ${tipo}`;
      const angulo = (Math.PI * 2 * i) / total + Math.random() * 0.3;
      const distancia = 220 + Math.random() * 420;
      const dx = Math.cos(angulo) * distancia;
      const dy = Math.sin(angulo) * distancia;
      const rot = (Math.random() - 0.5) * 720;
      const dur = 1200 + Math.random() * 600;
      const delay = 800 + Math.random() * 150;   // sincronizado con impacto
      p.style.transition = `transform ${dur}ms cubic-bezier(0.22, 0.61, 0.36, 1) ${delay}ms, opacity ${dur}ms ease-out ${delay}ms`;
      p.style.transform = 'translate(-50%, -50%) rotate(0deg)';
      p.style.opacity = '1';
      particulas.appendChild(p);
      void p.offsetWidth;
      requestAnimationFrame(() => {
        p.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) rotate(${rot}deg)`;
        p.style.opacity = '0';
      });
    }
    epic.classList.add('activa');
    epic.setAttribute('aria-hidden', 'false');
  }

  if (contenedor && inputReal && display && pluma && gotitas && btnEntrar) {
    const password = contenedor.dataset.password || '';

    const tinta = crearTintaEscritura({
      contenedor,
      inputReal,
      displayVisible: display,
      pluma,
      gotitas,
      password,
      onCorrecto: () => {
        sessionStorage.setItem('boda_auth', 'ok');
        lanzarEpica();
        // Redirigir tras la animación completa (~2.8s)
        setTimeout(() => {
          window.location.href = DESTINO;
        }, 2800);
      },
      onError: () => { /* clase .error ya aplicada por el motor */ },
    });

    inputReal.addEventListener('input', () => {
      if (inputReal.value.length >= 3) {
        contenedor.classList.add('tiene-texto');
        btnEntrar.disabled = false;
      } else {
        contenedor.classList.remove('tiene-texto');
        btnEntrar.disabled = true;
      }
    });

    contenedor.addEventListener('submit', (e) => {
      e.preventDefault();
      if (inputReal.value.length >= 3) tinta.verificar();
    });
  }
</script>
