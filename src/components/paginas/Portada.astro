---
import PaginaMarco from '../PaginaMarco.astro';
const WEDDING_DATE = '2027-07-24T12:30:00';
---

<PaginaMarco
  titulo="Portada"
  esquinaSupIzq="/img/svg/esquinas/olivo-sup-izq.svg"
  esquinaInfDer="/img/png/limones/limon-inf-der.png"
>
  <div class="portada-inner">
    <p class="invitacion">Estáis invitados a la boda de</p>

    <h1 class="nombres-wrap">
      <span class="palabra palabra-1">Alba</span>
      <span class="palabra palabra-2">&amp;</span>
      <span class="palabra palabra-3">Antonio</span>
    </h1>

    <div class="separador-limon">
      <span class="linea"></span>
      <span class="limon-mini" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="28" height="28" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Hoja pequeña -->
          <path d="M20 8 Q26 4 30 6 Q29 12 22 12 Z" fill="#C4714F" opacity="0.85"/>
          <line x1="22" y1="11" x2="27" y2="7" stroke="#9E5237" stroke-width="0.5" opacity="0.7"/>
          <!-- Limón en tono teja -->
          <ellipse cx="20" cy="24" rx="9" ry="11" fill="#C4714F"/>
          <ellipse cx="20" cy="24" rx="9" ry="11" fill="none" stroke="#9E5237" stroke-width="0.6" opacity="0.5"/>
          <circle cx="16" cy="21" r="0.7" fill="#9E5237" opacity="0.5"/>
          <circle cx="22" cy="22" r="0.6" fill="#9E5237" opacity="0.5"/>
          <circle cx="18" cy="27" r="0.7" fill="#9E5237" opacity="0.5"/>
          <circle cx="23" cy="28" r="0.5" fill="#9E5237" opacity="0.5"/>
          <path d="M20 34 Q20 36 21 36" stroke="#9E5237" stroke-width="0.8" fill="none" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="linea"></span>
    </div>

    <p class="fecha">24 · Julio · 2027</p>
    <p class="lugar">Priego de Córdoba</p>

    <div class="countdown" id="countdown-portada">
      <div class="unidad">
        <span class="num" data-cd="dias">000</span>
        <span class="lbl">días</span>
      </div>
      <div class="unidad">
        <span class="num" data-cd="horas">00</span>
        <span class="lbl">horas</span>
      </div>
      <div class="unidad">
        <span class="num" data-cd="min">00</span>
        <span class="lbl">min</span>
      </div>
      <div class="unidad">
        <span class="num" data-cd="seg">00</span>
        <span class="lbl">seg</span>
      </div>
    </div>

    <p class="pasar-pagina">
      <span>Desliza para entrar</span>
      <span class="flechita">→</span>
    </p>
  </div>
</PaginaMarco>

<style>
  .portada-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.75rem, 2.5vh, 1.2rem);
    text-align: center;
  }

  .invitacion {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    color: var(--color-tinta-clara);
    letter-spacing: 0.15em;
    margin: 0;
  }

  /* ─── Nombres ─────────────────────────────────────── */
  .nombres-wrap {
    font-family: var(--font-vibes);
    font-weight: 400;
    color: var(--color-tinta);
    line-height: 1;
    margin: 0.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .palabra { display: inline-block; }
  .palabra-1, .palabra-3 { font-size: clamp(4rem, 15vw, 7rem); }
  .palabra-2             { font-size: clamp(2rem, 7vw, 3.5rem); color: var(--color-teja); margin: -0.15em 0; }

  .separador-limon {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: clamp(180px, 45vw, 300px);
    margin: 0.5rem 0;
  }
  .separador-limon .linea {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--color-teja), transparent);
    opacity: 0.7;
  }
  .separador-limon .limon-mini {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fecha {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(0.85rem, 2.2vw, 1.1rem);
    color: var(--color-tinta);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    margin: 0;
  }
  .lugar {
    font-family: var(--font-brush);
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    color: var(--color-teja);
    letter-spacing: 0.02em;
    line-height: 1;
    margin: 0.2rem 0 0;
  }

  /* Countdown */
  .countdown {
    display: flex;
    gap: clamp(1rem, 4vw, 2.2rem);
    margin-top: 1.2rem;
  }
  .unidad { text-align: center; display: flex; flex-direction: column; gap: 0.15rem; }
  .num {
    font-family: var(--font-vibes);
    font-size: clamp(2.4rem, 8vw, 3.8rem);
    color: var(--color-tinta);
    line-height: 1;
    display: block;
  }
  .lbl {
    font-family: var(--font-sans);
    font-size: clamp(0.55rem, 1.4vw, 0.7rem);
    letter-spacing: 0.35em;
    color: var(--color-tinta-clara);
    text-transform: uppercase;
  }

  .pasar-pagina {
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: clamp(0.65rem, 1.6vw, 0.78rem);
    color: var(--color-tinta-clara);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .flechita {
    display: inline-block;
    animation: flechita 1.8s ease-in-out infinite;
  }
  @keyframes flechita {
    0%, 100% { transform: translateX(0); opacity: 0.5; }
    50%      { transform: translateX(6px); opacity: 1; }
  }
</style>

<script define:vars={{ WEDDING_DATE }}>
  const target = new Date(WEDDING_DATE).getTime();
  const pad = (n, d = 2) => String(Math.floor(n)).padStart(d, '0');
  const $ = (k) => document.querySelector(`#countdown-portada [data-cd="${k}"]`);

  function tick() {
    const diff = target - Date.now();
    if (diff <= 0) {
      ['dias','horas','min','seg'].forEach(k => { const el = $(k); if (el) el.textContent = '00'; });
      return;
    }
    const dias  = diff / (1000*60*60*24);
    const horas = (diff % (1000*60*60*24)) / (1000*60*60);
    const min   = (diff % (1000*60*60)) / (1000*60);
    const seg   = (diff % (1000*60)) / 1000;
    if ($('dias'))  $('dias').textContent  = pad(dias, 3);
    if ($('horas')) $('horas').textContent = pad(horas);
    if ($('min'))   $('min').textContent   = pad(min);
    if ($('seg'))   $('seg').textContent   = pad(seg);
  }
  tick();
  setInterval(tick, 1000);
</script>
