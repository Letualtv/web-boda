---
import PaginaMarco from '../PaginaMarco.astro';
import GotasTinta from '../GotasTinta.astro';
import EnlaceSiguiente from '../EnlaceSiguiente.astro';
import LimonMini from '../LimonMini.astro';
import BotonGuardarFecha from '../BotonGuardarFecha.astro';
---

<PaginaMarco
  titulo="La celebración"
  esquinaSupIzq="/img/svg/azulejos/azulejo-esquina-01.svg"
  esquinaInfDer="/img/svg/azulejos/azulejo-esquina-02.svg"
  scroll
>
  <GotasTinta slot="decoracion" variante={3} />
  <div class="celebracion-inner">
    <h2 class="titulo">La celebración</h2>

    <div class="separador">
      <span class="linea"></span>
      <LimonMini tam={24} />
      <span class="linea"></span>
    </div>

    <div class="bloques">
      <!-- Fecha y hora -->
      <section class="bloque">
        <h3 class="bloque-titulo">Cuándo</h3>
        <p class="bloque-principal">Sábado 24 de julio de 2027</p>
        <p class="bloque-detalle">Recogida en Priego · 19:30 h</p>
        <BotonGuardarFecha />
      </section>

      <!-- Lugar -->
      <section class="bloque">
        <h3 class="bloque-titulo">Dónde</h3>
        <p class="bloque-principal">Finca Genilla</p>
        <p class="bloque-detalle">Priego de Córdoba · Córdoba</p>
        <p class="bloque-nota">La ceremonia y el banquete son en el mismo sitio.</p>
      </section>

      <!-- Mapa -->
      <section class="bloque bloque-mapa">
        <a
          class="btn-mapa"
          href="https://maps.google.com/?q=Finca+Genilla+Priego+de+Córdoba"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          Abrir en Google Maps
        </a>
      </section>
    </div>

    <EnlaceSiguiente href="/etiqueta/" label="Etiqueta" />
  </div>
</PaginaMarco>

<style>
  .celebracion-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    width: 100%;
    max-width: 560px;
  }

  .titulo {
    font-family: var(--font-brush);
    font-weight: 400;
    font-size: clamp(2.5rem, 7vw, 3.6rem);
    color: var(--color-tinta);
    line-height: 1;
    margin: 0;
  }

  .separador {
    display: flex; align-items: center; gap: 0.75rem;
    width: clamp(120px, 30vw, 180px);
    margin: 0.5rem 0 1rem;
  }
  .separador .linea {
    flex: 1; height: 1px;
    background: linear-gradient(to right, transparent, var(--color-teja), transparent);
  }

  .bloques {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
    align-items: center;
  }

  .bloque {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }
  .bloque :global(.btn-guardar-fecha) {
    margin-top: 0.85rem;
  }

  .bloque-titulo {
    font-family: var(--font-brush);
    font-weight: 400;
    color: var(--color-teja);
    font-size: clamp(1.4rem, 4vw, 1.8rem);
    margin: 0 0 0.5rem;
    line-height: 1;
  }

  .bloque-principal {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.1rem, 2.8vw, 1.35rem);
    color: var(--color-tinta);
    margin: 0;
  }

  .bloque-detalle {
    font-family: var(--font-sans);
    font-size: clamp(0.85rem, 2vw, 0.95rem);
    color: var(--color-tinta-clara);
    letter-spacing: 0.05em;
    margin: 0;
  }

  .bloque-nota {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(0.85rem, 2vw, 0.95rem);
    color: var(--color-tinta-clara);
    opacity: 0.85;
    margin: 0.4rem 0 0;
  }

  .btn-mapa {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-tinta);
    padding: 0.85rem 1.75rem;
    border: 1px solid rgba(30, 58, 95, 0.35);
    transition: background 250ms ease, border-color 250ms ease;
  }
  .btn-mapa:hover {
    background: rgba(30, 58, 95, 0.06);
    border-color: var(--color-tinta);
  }

  .ornamento {
    margin: 1.5rem 0 0;
    display: flex;
    justify-content: center;
    opacity: 0.9;
  }

  .nav-pareja {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-top: 1rem;
  }
</style>
