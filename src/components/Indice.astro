---
/**
 * Índice — overlay tipo tabla de contenidos.
 * Se abre con el botón de índice, se cierra con ESC, X o click fuera.
 */
const ENTRADAS = [
  { num: 'II',  titulo: 'Bienvenida',      pagina: 2 },
  { num: 'III', titulo: 'Nuestra historia', pagina: 3 },
  { num: 'IV',  titulo: 'La celebración',   pagina: 4 },
  { num: 'V',   titulo: 'Cómo llegar',      pagina: 5 },
  { num: 'VI',  titulo: 'Recuerdos',        pagina: 6 },
];
---

<div id="indice-overlay" class="indice-overlay" role="dialog" aria-modal="true" aria-label="Índice">
  <button id="btn-cerrar-indice" class="btn-cerrar" aria-label="Cerrar índice">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="6" y1="6" x2="18" y2="18"/>
      <line x1="6" y1="18" x2="18" y2="6"/>
    </svg>
  </button>

  <div class="indice-inner">
    <h2 class="indice-titulo">Índice</h2>
    <ul class="indice-lista">
      {ENTRADAS.map((entrada) => (
        <li class="indice-entrada">
          <button class="entrada-btn" data-pagina={entrada.pagina}>
            <span class="num">{entrada.num}.</span>
            <span class="titulo">{entrada.titulo}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .indice-overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(243, 233, 210, 0.94);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 400ms ease;
  }
  .indice-overlay.abierto {
    opacity: 1;
    pointer-events: auto;
  }

  .btn-cerrar {
    position: absolute;
    top: clamp(1rem, 3vh, 1.75rem);
    right: clamp(1rem, 3vw, 1.75rem);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid rgba(30, 58, 95, 0.2);
    color: var(--color-tinta);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 250ms ease;
  }
  .btn-cerrar:hover { background: rgba(30, 58, 95, 0.08); }

  .indice-inner {
    text-align: center;
    padding: 2rem;
    max-width: 500px;
    width: 100%;
  }

  .indice-titulo {
    font-family: var(--font-brush);
    font-weight: 400;
    font-size: clamp(2.5rem, 8vw, 4rem);
    color: var(--color-tinta);
    margin: 0 0 2rem;
    line-height: 1;
  }

  .indice-lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 2vh, 1rem);
  }

  .indice-entrada {
    display: block;
  }

  .entrada-btn {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 1rem;
    width: 100%;
    background: transparent;
    border: none;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 3.5vw, 1.6rem);
    color: var(--color-tinta);
    cursor: pointer;
    padding: 0.75rem 1rem;
    transition: color 250ms ease, transform 250ms ease;
  }
  .entrada-btn:hover {
    color: var(--color-teja);
    transform: translateX(4px);
  }

  .entrada-btn .num {
    font-family: var(--font-sans);
    font-size: 0.75em;
    color: var(--color-limon);
    letter-spacing: 0.1em;
  }

  .entrada-btn .titulo {
    font-family: var(--font-brush);
    font-weight: 400;
    font-size: 1.2em;
  }

  /* Reducir motion */
  @media (prefers-reduced-motion: reduce) {
    .indice-overlay { transition: opacity 0.01ms; }
  }
</style>

<script>
  const overlay = document.getElementById('indice-overlay') as HTMLElement;
  const btnCerrar = document.getElementById('btn-cerrar-indice') as HTMLElement;

  function abrir() {
    overlay.classList.add('abierto');
    // atrapar foco
    btnCerrar.focus();
  }

  function cerrar() {
    overlay.classList.remove('abierto');
  }

  document.addEventListener('boda:abrir-indice', abrir);

  btnCerrar.addEventListener('click', cerrar);

  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) cerrar();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('abierto')) {
      cerrar();
    }
  });

  // Enlaces de navegación
  overlay.querySelectorAll<HTMLButtonElement>('.entrada-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const pagina = Number(btn.dataset.pagina);
      cerrar();
      setTimeout(() => {
        document.dispatchEvent(new CustomEvent('boda:navegar', { detail: pagina }));
      }, 200);
    });
  });
</script>
