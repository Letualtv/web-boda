---
/**
 * Libro con efecto de pase de página real usando StPageFlip.
 * Portrait mode: una página a pantalla completa, se pasa desde el borde inferior
 * hacia arriba (peel effect con sombras nativas de la librería).
 */
import Portada    from './paginas/Portada.astro';
import Acceso     from './paginas/Acceso.astro';
import Bienvenida from './paginas/Bienvenida.astro';
import Historia   from './paginas/Historia.astro';
import Celebracion from './paginas/Celebracion.astro';
import Autobuses  from './paginas/Autobuses.astro';
import Galeria    from './paginas/Galeria.astro';

import Indice          from './Indice.astro';
import IndicadorPagina from './IndicadorPagina.astro';
---

<div id="libro-wrap" class="libro-wrap">
  <div id="libro" class="libro">
    <div class="page"><Portada /></div>
    <div class="page"><Acceso /></div>
    <div class="page"><Bienvenida /></div>
    <div class="page"><Historia /></div>
    <div class="page"><Celebracion /></div>
    <div class="page"><Autobuses /></div>
    <div class="page"><Galeria /></div>
  </div>

  <button id="btn-indice" class="btn-indice" aria-label="Abrir índice">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="4" y1="7"  x2="20" y2="7"/>
      <line x1="4" y1="12" x2="20" y2="12"/>
      <line x1="4" y1="17" x2="20" y2="17"/>
    </svg>
  </button>

  <Indice />
  <IndicadorPagina />
</div>

<style>
  .libro-wrap {
    position: fixed;
    inset: 0;
    z-index: 2;
    overflow: hidden;
  }

  .libro {
    width: 100vw;
    height: 100dvh;
    margin: 0 auto;
    /* StPageFlip inyecta sus propios estilos, dejamos que gestione todo */
  }

  /* Cada .page ocupará el tamaño que StPageFlip le asigne */
  :global(.page) {
    background: var(--color-papel);
    /* Sombra sutil como si fuera hoja de papel real */
    box-shadow:
      inset 0 0 60px rgba(50, 30, 15, 0.06),
      0 4px 12px rgba(30, 20, 10, 0.15);
  }
  :global(.stf__parent) {
    background: transparent;
  }
  :global(.stf__block) {
    background: transparent;
  }

  /* Botón índice */
  .btn-indice {
    position: fixed;
    top: clamp(0.75rem, 2vw, 1.25rem);
    right: clamp(0.75rem, 2vw, 1.25rem);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(243, 233, 210, 0.85);
    border: 1px solid rgba(30, 58, 95, 0.2);
    color: var(--color-tinta);
    z-index: 50;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 400ms ease, background 250ms ease;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }
  .btn-indice.visible {
    opacity: 0.85;
    pointer-events: auto;
  }
  .btn-indice:hover { opacity: 1; background: rgba(243, 233, 210, 0.95); }
  .btn-indice:active { transform: scale(0.95); }
</style>

<script>
  import { PageFlip } from 'page-flip';

  const TOTAL_PAGINAS = 7;
  const STORAGE_KEY = 'boda_auth';

  let autenticado = sessionStorage.getItem(STORAGE_KEY) === 'ok';
  let paginaActual = autenticado ? 2 : 0;

  const libro = document.getElementById('libro') as HTMLElement;
  const btnIndice = document.getElementById('btn-indice') as HTMLElement;
  const indicador = document.getElementById('indicador-pagina') as HTMLElement;
  const romanos = indicador?.querySelector('.romanos') as HTMLElement;

  const ROMANOS = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII'];

  function actualizarIndicador() {
    if (!romanos || !indicador) return;
    if (!autenticado || paginaActual < 2) {
      indicador.classList.remove('visible');
      return;
    }
    indicador.classList.add('visible');
    romanos.innerHTML = `<span class="actual">${ROMANOS[paginaActual]}</span> · ${ROMANOS[TOTAL_PAGINAS - 1]}`;
  }

  function actualizarUI() {
    if (autenticado && paginaActual >= 2) {
      btnIndice.classList.add('visible');
    } else {
      btnIndice.classList.remove('visible');
    }
    actualizarIndicador();
  }

  // ─── Inicializar PageFlip ─────────────────────────────
  const pageFlip = new PageFlip(libro, {
    width: 550,
    height: 900,
    size: 'stretch',
    minWidth: 300,
    minHeight: 480,
    maxWidth: 900,
    maxHeight: 1400,
    maxShadowOpacity: 0.5,
    showCover: false,
    usePortrait: true,
    autoSize: true,
    mobileScrollSupport: true,
    clickEventForward: true,
    useMouseEvents: true,
    swipeDistance: 30,
    drawShadow: true,
    flippingTime: 800,
    startPage: paginaActual,
  });

  pageFlip.loadFromHTML(document.querySelectorAll('.page'));

  // ─── Bloqueo por contraseña ────────────────────────────
  pageFlip.on('flip', (e: any) => {
    const nueva = e.data;
    // Si intenta pasar de la 1 sin autenticar, volver a la 1
    if (!autenticado && nueva > 1) {
      setTimeout(() => pageFlip.flip(1), 0);
      return;
    }
    paginaActual = nueva;
    actualizarUI();
  });

  // ─── Autenticación ─────────────────────────────────────
  document.addEventListener('boda:autenticado', () => {
    autenticado = true;
    sessionStorage.setItem(STORAGE_KEY, 'ok');
    setTimeout(() => pageFlip.flip(2), 600);
  });

  // ─── Índice ────────────────────────────────────────────
  btnIndice.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('boda:abrir-indice'));
  });

  document.addEventListener('boda:navegar', (e: any) => {
    const dest = Number(e.detail);
    if (!Number.isFinite(dest)) return;
    pageFlip.flip(dest);
  });

  // ─── Teclado ───────────────────────────────────────────
  window.addEventListener('keydown', (e: KeyboardEvent) => {
    const target = e.target as HTMLElement;
    if (target.matches('input, textarea')) return;
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === 'PageDown') {
      pageFlip.flipNext();
    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp' || e.key === 'PageUp') {
      pageFlip.flipPrev();
    } else if (e.key === 'Home') {
      pageFlip.flip(0);
    } else if (e.key === 'End' && autenticado) {
      pageFlip.flip(TOTAL_PAGINAS - 1);
    }
  });

  actualizarUI();
</script>
