---
/**
 * Contenedor principal del libro.
 * Gestiona estado global (paginaActual, autenticado, indiceAbierto),
 * inicializa gestos y coordina las páginas.
 */
import Portada    from './paginas/Portada.astro';
import Acceso     from './paginas/Acceso.astro';
import Bienvenida from './paginas/Bienvenida.astro';
import Historia   from './paginas/Historia.astro';
import Celebracion from './paginas/Celebracion.astro';
import Autobuses  from './paginas/Autobuses.astro';
import Galeria    from './paginas/Galeria.astro';

import Indice          from './Indice.astro';
import IndicadorPagina from './IndicadorPagina.astro';
import FlechasNav      from './FlechasNav.astro';
---

<div id="libro" class="libro">
  <div id="cinta" class="cinta">
    <Portada />
    <Acceso />
    <Bienvenida />
    <Historia />
    <Celebracion />
    <Autobuses />
    <Galeria />
  </div>

  <!-- Botón de índice — arriba a la derecha -->
  <button id="btn-indice" class="btn-indice" aria-label="Abrir índice">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="4" y1="7"  x2="20" y2="7"/>
      <line x1="4" y1="12" x2="20" y2="12"/>
      <line x1="4" y1="17" x2="20" y2="17"/>
    </svg>
  </button>

  <Indice />
  <IndicadorPagina />
  <FlechasNav />
</div>

<style>
  .libro {
    position: fixed;
    inset: 0;
    overflow: hidden;
    z-index: 2;
  }

  .cinta {
    display: flex;
    height: 100%;
    width: 100%;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  /* Botón de índice */
  .btn-indice {
    position: fixed;
    top: clamp(0.75rem, 2vw, 1.25rem);
    right: clamp(0.75rem, 2vw, 1.25rem);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(243, 233, 210, 0.55);
    border: 1px solid rgba(30, 58, 95, 0.15);
    color: var(--color-tinta);
    z-index: 45;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 400ms ease, background 250ms ease;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }
  .btn-indice.visible {
    opacity: 0.75;
    pointer-events: auto;
  }
  .btn-indice:hover  { opacity: 1; background: rgba(243, 233, 210, 0.85); }
  .btn-indice:active { transform: scale(0.95); }
</style>

<script>
  import { crearPaseDePagina } from './efectos/PaseDePagina';

  const TOTAL_PAGINAS = 7;
  const STORAGE_KEY = 'boda_auth';

  // ─── Estado ────────────────────────────────────────────
  let autenticado = sessionStorage.getItem(STORAGE_KEY) === 'ok';
  let paginaActual = autenticado ? 2 : 0;

  const libro = document.getElementById('libro') as HTMLElement;
  const cinta = document.getElementById('cinta') as HTMLElement;
  const btnIndice = document.getElementById('btn-indice') as HTMLElement;
  const indicador = document.getElementById('indicador-pagina') as HTMLElement;
  const romanos = indicador?.querySelector('.romanos') as HTMLElement;
  const flechaIzq = document.getElementById('flecha-izq') as HTMLElement;
  const flechaDer = document.getElementById('flecha-der') as HTMLElement;

  // ─── Motor de gestos ───────────────────────────────────
  const motor = crearPaseDePagina({
    contenedor: libro,
    cinta,
    totalPaginas: TOTAL_PAGINAS,
    paginaMaxPermitida: () => (autenticado ? TOTAL_PAGINAS - 1 : 1),
    onCambio: (nueva) => {
      paginaActual = nueva;
      actualizarUI();
    },
  });

  // ─── Números romanos ───────────────────────────────────
  const ROMANOS = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII'];
  function actualizarIndicador() {
    if (!romanos || !indicador) return;
    if (!autenticado || paginaActual < 2) {
      indicador.classList.remove('visible');
      return;
    }
    indicador.classList.add('visible');
    romanos.innerHTML = `<span class="actual">${ROMANOS[paginaActual]}</span> · ${ROMANOS[TOTAL_PAGINAS - 1]}`;
  }

  // ─── UI global ─────────────────────────────────────────
  function actualizarUI() {
    if (autenticado && paginaActual >= 2) {
      btnIndice.classList.add('visible');
    } else {
      btnIndice.classList.remove('visible');
    }
    actualizarIndicador();
  }

  // ─── Autenticación (dispatched por Acceso.astro) ───────
  document.addEventListener('boda:autenticado', () => {
    autenticado = true;
    sessionStorage.setItem(STORAGE_KEY, 'ok');
    // avanza a página 2 (Bienvenida) tras 600ms para que se vea el "secado"
    setTimeout(() => motor.irA(2, true), 600);
  });

  // ─── Índice ────────────────────────────────────────────
  btnIndice.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('boda:abrir-indice'));
  });

  document.addEventListener('boda:navegar', (e: any) => {
    const dest = Number(e.detail);
    if (!Number.isFinite(dest)) return;
    motor.irA(dest, true);
  });

  // ─── Flechas ───────────────────────────────────────────
  flechaIzq?.addEventListener('click', () => motor.irA(paginaActual - 1));
  flechaDer?.addEventListener('click', () => motor.irA(paginaActual + 1));

  // ─── Arranque ──────────────────────────────────────────
  motor.forzar(paginaActual);
  actualizarUI();
</script>
