---
/**
 * Flechas laterales para pasar página.
 * Ocultas por defecto — se activan añadiendo la clase `.con-flechas` al #libro.
 */
---

<button id="flecha-izq" class="flecha flecha-izq" aria-label="Página anterior">
  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M15 18l-6-6 6-6"/>
  </svg>
</button>

<button id="flecha-der" class="flecha flecha-der" aria-label="Página siguiente">
  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M9 18l6-6-6-6"/>
  </svg>
</button>

<style>
  .flecha {
    display: none;              /* ocultas por defecto */
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(243, 233, 210, 0.7);
    border: 1px solid rgba(30, 58, 95, 0.15);
    color: var(--color-tinta);
    z-index: 45;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 250ms ease, background 250ms ease, transform 250ms ease;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }
  .flecha:hover { opacity: 1; background: rgba(243, 233, 210, 0.95); }
  .flecha:active { transform: translateY(-50%) scale(0.95); }
  .flecha-izq { left: clamp(0.75rem, 3vw, 2rem); }
  .flecha-der { right: clamp(0.75rem, 3vw, 2rem); }

  /* Se activan añadiendo `.con-flechas` al #libro */
  :global(#libro.con-flechas) ~ .flecha,
  :global(.con-flechas) .flecha,
  :global(#libro.con-flechas) .flecha {
    display: flex;
  }
</style>
