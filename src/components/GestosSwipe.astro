---
/**
 * Gestos de pasar página en toda la web.
 * - Swipe horizontal → navega a ruta anterior/siguiente
 * - Detecta intención horizontal vs vertical: no interfiere con scroll
 * - Ignora inputs, botones, enlaces, overlays y contenido con scroll interno
 * - Respeta autenticación (no salta a página protegida sin sesión)
 */
---

<script>
  import { navigate } from 'astro:transitions/client';

  const SECUENCIA = [
    '/',
    '/acceso/',
    '/bienvenida/',
    '/historia/',
    '/celebracion/',
    '/autobuses/',
    '/galeria/',
  ];

  const BASE = import.meta.env.BASE_URL;

  const norm = (u: string) => (BASE + u).replace(/\/+/g, '/');

  function pathActual(): string {
    let p = window.location.pathname;
    // eliminar prefijo base
    if (BASE !== '/' && p.startsWith(BASE)) {
      p = p.slice(BASE.length - 1);
    }
    if (!p.startsWith('/')) p = '/' + p;
    if (p !== '/' && !p.endsWith('/')) p = p + '/';
    return p;
  }

  function autenticado(): boolean {
    try { return sessionStorage.getItem('boda_auth') === 'ok'; } catch { return false; }
  }

  function siguiente(): string | null {
    const idx = SECUENCIA.indexOf(pathActual());
    if (idx < 0 || idx >= SECUENCIA.length - 1) return null;
    const destIdx = idx + 1;
    // Bienvenida (idx 2) en adelante requieren autenticación
    if (destIdx >= 2 && !autenticado()) return null;
    return norm(SECUENCIA[destIdx]);
  }

  function anterior(): string | null {
    const idx = SECUENCIA.indexOf(pathActual());
    if (idx <= 0) return null;
    return norm(SECUENCIA[idx - 1]);
  }

  // ─── Umbrales ─────────────────────────────────────────
  const UMBRAL_DISTANCIA = 70;   // píxeles mínimos para considerar swipe válido
  const UMBRAL_VELOCIDAD = 0.35; // px/ms
  const UMBRAL_INTENCION = 10;   // píxeles para decidir eje

  type Intencion = 'indefinido' | 'horizontal' | 'vertical';

  let inicioX = 0, inicioY = 0, inicioT = 0;
  let intencion: Intencion = 'indefinido';
  let activo = false;

  function debeIgnorar(target: EventTarget | null): boolean {
    if (!(target instanceof Element)) return false;
    return !!target.closest(
      'input, textarea, button, a, [role="button"], .idx-overlay, .pagina-scroll, .epic-overlay'
    );
  }

  function inicio(x: number, y: number, target: EventTarget | null) {
    if (debeIgnorar(target)) { activo = false; return; }
    activo = true;
    intencion = 'indefinido';
    inicioX = x; inicioY = y;
    inicioT = performance.now();
  }

  function mover(x: number, y: number, evento?: TouchEvent) {
    if (!activo) return;
    const dx = x - inicioX;
    const dy = y - inicioY;
    const absX = Math.abs(dx);
    const absY = Math.abs(dy);
    if (intencion === 'indefinido') {
      if (absX < UMBRAL_INTENCION && absY < UMBRAL_INTENCION) return;
      intencion = absX > absY ? 'horizontal' : 'vertical';
      if (intencion === 'vertical') { activo = false; return; }
    }
    if (intencion === 'horizontal' && evento && evento.cancelable) {
      evento.preventDefault();
    }
  }

  function fin(x: number) {
    if (!activo || intencion !== 'horizontal') { activo = false; return; }
    activo = false;
    const dx = x - inicioX;
    const dur = performance.now() - inicioT;
    const vel = Math.abs(dx) / dur;
    if (Math.abs(dx) < UMBRAL_DISTANCIA && vel < UMBRAL_VELOCIDAD) return;

    // Swipe izquierda = siguiente, derecha = anterior
    const destino = dx < 0 ? siguiente() : anterior();
    if (destino) navigate(destino);
  }

  // ─── Touch ────────────────────────────────────────────
  document.addEventListener('touchstart', (e: TouchEvent) => {
    inicio(e.touches[0].clientX, e.touches[0].clientY, e.target);
  }, { passive: true });

  document.addEventListener('touchmove', (e: TouchEvent) => {
    if (activo) mover(e.touches[0].clientX, e.touches[0].clientY, e);
  }, { passive: false });

  document.addEventListener('touchend', (e: TouchEvent) => {
    if (activo && e.changedTouches[0]) fin(e.changedTouches[0].clientX);
  });

  document.addEventListener('touchcancel', () => { activo = false; });

  // ─── Mouse (desktop) ──────────────────────────────────
  document.addEventListener('mousedown', (e: MouseEvent) => {
    if (e.button !== 0) return;
    inicio(e.clientX, e.clientY, e.target);
  });

  document.addEventListener('mousemove', (e: MouseEvent) => {
    if (activo) mover(e.clientX, e.clientY);
  });

  document.addEventListener('mouseup', (e: MouseEvent) => {
    if (activo) fin(e.clientX);
  });

  document.addEventListener('mouseleave', () => { activo = false; });

  // ─── Teclado ──────────────────────────────────────────
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    const t = e.target as HTMLElement;
    if (t.matches && t.matches('input, textarea')) return;
    if (e.key === 'ArrowRight' || e.key === 'PageDown') {
      const d = siguiente(); if (d) navigate(d);
    } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
      const d = anterior(); if (d) navigate(d);
    }
  });
</script>
