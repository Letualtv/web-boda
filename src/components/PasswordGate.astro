---
// INTENCIONADO: contraseña en texto plano. Sitio de boda sin datos sensibles.
const PASSWORD = 'genilla2027';
const BASE_URL = import.meta.env.BASE_URL;
---

<style>
  #gate-wrap {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0a1422;
    overflow: hidden;
    transition: opacity 0.7s ease;
  }

  #gate-inner {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    padding: 4rem 3rem;
    width: 100%;
    max-width: 480px;
    text-align: center;
    opacity: 0;
    transform: translateY(20px);
    animation: gateIn 1.1s cubic-bezier(.22,.68,0,1) 0.2s both;
  }

  @keyframes gateIn {
    to { opacity: 1; transform: translateY(0); }
  }

  .gate-monogram {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(4.5rem, 12vw, 7rem);
    color: #FAF6EE;
    line-height: 1;
    margin: 0;
  }

  .gate-date {
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 300;
    letter-spacing: 0.45em;
    color: rgba(250,246,238,0.5);
    text-transform: uppercase;
    margin: 0.7rem 0 0;
  }

  .gate-sep {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 200px;
  }
  .gate-sep-ln  { flex: 1; height: 1px; background: rgba(212,200,74,0.35); }
  .gate-sep-dia { width: 6px; height: 6px; background: #D4C84A; transform: rotate(45deg); opacity: 0.75; flex-shrink: 0; }

  .gate-form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    align-items: center;
  }

  .gate-field-wrap {
    width: 100%;
  }

  .gate-label {
    display: block;
    font-family: 'Lato', sans-serif;
    font-size: 0.7rem;
    color: rgba(250,246,238,0.45);
    letter-spacing: 0.5em;
    text-transform: uppercase;
    margin-bottom: 1.1rem;
  }

  #pwd-field {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(250,246,238,0.25);
    color: #FAF6EE;
    text-align: center;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.6rem;
    font-weight: 300;
    letter-spacing: 0.45em;
    padding: 0.6rem 0;
    width: 100%;
    outline: none;
    transition: border-color 0.4s;
    caret-color: #D4C84A;
  }
  #pwd-field:focus        { border-bottom-color: rgba(212,200,74,0.6); }
  #pwd-field::placeholder { color: rgba(250,246,238,0.18); }

  #pwd-error {
    font-family: 'Lato', sans-serif;
    font-size: 0.7rem;
    color: rgba(230,130,130,0.9);
    letter-spacing: 0.2em;
    margin: 0;
    display: none;
  }

  #btn-entrar {
    background: transparent;
    border: 1px solid rgba(212,200,74,0.4);
    color: rgba(212,200,74,0.8);
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    padding: 1.1rem 3.5rem;
    cursor: pointer;
    width: 100%;
    transition: border-color 0.3s, color 0.3s, background 0.3s;
  }
  #btn-entrar:hover  {
    border-color: #D4C84A;
    color: #D4C84A;
    background: rgba(212,200,74,0.06);
  }
  #btn-entrar:active { opacity: 0.7; }

  .gate-note {
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 0.6rem;
    color: rgba(250,246,238,0.18);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    margin: 0;
  }
</style>

<div id="gate-wrap">
  <div id="gate-inner">

    <div>
      <p class="gate-monogram">A &amp; A</p>
      <p class="gate-date">24 · Julio · 2027</p>
    </div>

    <div class="gate-sep">
      <div class="gate-sep-ln"></div>
      <div class="gate-sep-dia"></div>
      <div class="gate-sep-ln"></div>
    </div>

    <form id="password-form" class="gate-form">
      <div class="gate-field-wrap">
        <label class="gate-label" for="pwd-field">Contraseña</label>
        <input id="pwd-field" type="password" autocomplete="current-password" placeholder="· · · · · · · ·"/>
      </div>
      <p id="pwd-error">Contraseña incorrecta</p>
      <button id="btn-entrar" type="submit">Entrar</button>
    </form>

    <p class="gate-note">Sitio privado · Solo invitados</p>

  </div>
</div>

<script define:vars={{ PASSWORD, BASE_URL }}>
  const STORAGE_KEY = 'boda_auth';
  const BODA_URL = BASE_URL + 'boda/';

  if (sessionStorage.getItem(STORAGE_KEY) === 'ok') {
    window.location.replace(BODA_URL);
  }

  document.getElementById('pwd-field').addEventListener('input', () => {
    document.getElementById('pwd-error').style.display = 'none';
  });

  document.getElementById('password-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('pwd-field').value.trim().toLowerCase();

    if (input === PASSWORD) {
      sessionStorage.setItem(STORAGE_KEY, 'ok');
      const wrap = document.getElementById('gate-wrap');
      wrap.style.opacity = '0';
      setTimeout(() => window.location.replace(BODA_URL), 700);
    } else {
      document.getElementById('pwd-error').style.display = 'block';
      document.getElementById('pwd-field').value = '';
      document.getElementById('pwd-field').focus();
    }
  });
</script>
