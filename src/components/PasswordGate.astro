---
// INTENCIONADO: contraseña en texto plano. Sitio de boda sin datos sensibles.
const PASSWORD = 'genilla2027';
const BASE_URL = import.meta.env.BASE_URL;
---

<style>
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .g-1 { animation: fadeUp 1s cubic-bezier(.22,.68,0,1.2) both; animation-delay: 0.15s; }
  .g-2 { animation: fadeUp 1s cubic-bezier(.22,.68,0,1.2) both; animation-delay: 0.4s;  }
  .g-3 { animation: fadeUp 1s cubic-bezier(.22,.68,0,1.2) both; animation-delay: 0.65s; }
  .g-4 { animation: fadeUp 1s cubic-bezier(.22,.68,0,1.2) both; animation-delay: 0.9s;  }

  #pwd-field {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(250,246,238,0.25);
    color: #FAF6EE;
    text-align: center;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 300;
    letter-spacing: 0.4em;
    padding: 0.6rem 0;
    width: 100%;
    outline: none;
    transition: border-color 0.4s;
    caret-color: #D4C84A;
  }
  #pwd-field:focus          { border-bottom-color: #D4C84A; }
  #pwd-field::placeholder   { color: rgba(250,246,238,0.15); letter-spacing: 0.5em; }

  #btn-entrar {
    background: transparent;
    border: 1px solid rgba(212,200,74,0.5);
    color: #D4C84A;
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    padding: 0.9rem 2.5rem;
    cursor: pointer;
    width: 100%;
    transition: background 0.3s, border-color 0.3s, color 0.3s;
  }
  #btn-entrar:hover {
    background: rgba(212,200,74,0.12);
    border-color: #D4C84A;
  }
  #btn-entrar:active { opacity: 0.8; }

  #gate-wrap {
    transition: opacity 0.6s ease;
  }
</style>

<div id="gate-wrap" style="position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;background:#0a1520;overflow:hidden;">

  <!-- Patrón geométrico nazarí — fondo decorativo -->
  <svg aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;opacity:0.07;" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="nazari" x="0" y="0" width="72" height="72" patternUnits="userSpaceOnUse">
        <!-- Marco exterior del mosaico -->
        <rect x="0.5" y="0.5" width="71" height="71" fill="none" stroke="#D4C84A" stroke-width="0.4"/>
        <!-- Estrella de 8 puntas -->
        <polygon points="36,8 41,27 60,22 45,36 60,50 41,45 36,64 31,45 12,50 27,36 12,22 31,27"
                 fill="none" stroke="#D4C84A" stroke-width="0.6"/>
        <!-- Cuadrado interior rotado 45° -->
        <rect x="25" y="25" width="22" height="22" fill="none" stroke="#D4C84A" stroke-width="0.4"
              transform="rotate(45 36 36)"/>
        <!-- Círculo central -->
        <circle cx="36" cy="36" r="5" fill="none" stroke="#D4C84A" stroke-width="0.4"/>
        <!-- Líneas de encuadre intermedias -->
        <line x1="36" y1="0"  x2="36" y2="72" stroke="#D4C84A" stroke-width="0.2"/>
        <line x1="0"  y1="36" x2="72" y2="36" stroke="#D4C84A" stroke-width="0.2"/>
        <!-- Puntos en esquinas -->
        <circle cx="0"  cy="0"  r="1.5" fill="#D4C84A"/>
        <circle cx="72" cy="0"  r="1.5" fill="#D4C84A"/>
        <circle cx="0"  cy="72" r="1.5" fill="#D4C84A"/>
        <circle cx="72" cy="72" r="1.5" fill="#D4C84A"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#nazari)"/>
  </svg>

  <!-- Viñeta radial para centrar la atención -->
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 70% 80% at center, transparent 30%, #0a1520 100%);"></div>

  <!-- Contenido -->
  <div style="position:relative;z-index:10;display:flex;flex-direction:column;align-items:center;gap:2.25rem;padding:2.5rem 2rem;width:100%;max-width:320px;text-align:center;">

    <!-- Ornamento superior -->
    <div class="g-1" style="display:flex;align-items:center;gap:1rem;width:100%;">
      <div style="flex:1;height:1px;background:linear-gradient(to right,transparent,rgba(212,200,74,0.35));"></div>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="#D4C84A" opacity="0.6">
        <path d="M7 0 L8.2 5.8 L14 7 L8.2 8.2 L7 14 L5.8 8.2 L0 7 L5.8 5.8 Z"/>
      </svg>
      <div style="flex:1;height:1px;background:linear-gradient(to left,transparent,rgba(212,200,74,0.35));"></div>
    </div>

    <!-- Monograma -->
    <div class="g-2">
      <p style="font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-weight:300;font-size:clamp(3.5rem,14vw,5.5rem);color:#D4C84A;letter-spacing:0.1em;line-height:1;margin:0;">
        A &amp; A
      </p>
      <p style="font-family:'Lato',system-ui,sans-serif;font-weight:300;font-size:0.6rem;color:rgba(250,246,238,0.4);letter-spacing:0.5em;text-transform:uppercase;margin-top:1rem;">
        24 · Julio · 2027
      </p>
    </div>

    <!-- Separador ornamental -->
    <div class="g-3" style="display:flex;align-items:center;gap:0.75rem;width:75%;">
      <div style="flex:1;height:1px;background:rgba(212,200,74,0.2);"></div>
      <svg width="8" height="8" viewBox="0 0 8 8" fill="none" stroke="#D4C84A" stroke-width="0.8" opacity="0.45">
        <rect x="1" y="1" width="6" height="6" transform="rotate(45 4 4)"/>
      </svg>
      <div style="flex:1;height:1px;background:rgba(212,200,74,0.2);"></div>
    </div>

    <!-- Formulario -->
    <form id="password-form" class="g-4" style="width:100%;display:flex;flex-direction:column;gap:1.5rem;align-items:center;">
      <div style="width:100%;">
        <label for="pwd-field" style="display:block;font-family:'Lato',sans-serif;font-size:0.55rem;color:rgba(250,246,238,0.3);letter-spacing:0.55em;text-transform:uppercase;margin-bottom:0.75rem;">
          Contraseña
        </label>
        <input id="pwd-field" type="password" autocomplete="current-password" placeholder="· · · · · · · ·"/>
      </div>
      <p id="pwd-error" style="font-family:'Lato',sans-serif;font-size:0.65rem;color:#7A2D3E;letter-spacing:0.15em;margin:0;display:none;">
        Contraseña incorrecta
      </p>
      <button id="btn-entrar" type="submit">Entrar</button>
    </form>

  </div>
</div>

<script define:vars={{ PASSWORD, BASE_URL }}>
  const STORAGE_KEY = 'boda_auth';
  const BODA_URL = BASE_URL + 'boda/';

  if (sessionStorage.getItem(STORAGE_KEY) === 'ok') {
    window.location.replace(BODA_URL);
  }

  document.getElementById('pwd-field').addEventListener('input', () => {
    document.getElementById('pwd-error').style.display = 'none';
  });

  document.getElementById('password-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('pwd-field').value.trim().toLowerCase();

    if (input === PASSWORD) {
      sessionStorage.setItem(STORAGE_KEY, 'ok');
      const wrap = document.getElementById('gate-wrap');
      wrap.style.opacity = '0';
      setTimeout(() => window.location.replace(BODA_URL), 600);
    } else {
      document.getElementById('pwd-error').style.display = 'block';
      document.getElementById('pwd-field').value = '';
      document.getElementById('pwd-field').focus();
    }
  });
</script>
